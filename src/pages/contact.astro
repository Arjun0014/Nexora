---
import Base from '../layouts/Base.astro';
import PageHead from '../components/ui/PageHead.astro';
import Arrow from '../components/ui/Arrow.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import { site, cta } from '../data/site';

const hasDetails = Boolean(site.email || site.phone || site.whatsapp || site.address.length);
---
<Base title="Contact" description="Contact Nexora Hospitality and Services in Doha, Qatar. Employers can request workforce; candidates can register a CV." theme="paper">
  <PageHead label="Contact" title={['Start with', 'the right door.']} lead="Two of these get you to the right person faster than a general message." />

  <section class="ct surface" data-theme="paper" aria-label="Ways to reach us">
    <div class="wrap grid">
      <ul class="ct__doors">
        <li>
          <a class="ct__door" href={cta.employer.href}>
            <span class="label label--soft">For employers</span>
            <span class="h2">I need people.</span>
            <span class="small soft">Roles, numbers, dates. Two short steps.</span>
            <span class="label ct__go">{cta.employer.label}<Arrow /></span>
          </a>
        </li>
        <li>
          <a class="ct__door" href={cta.candidate.href}>
            <span class="label label--soft">For candidates</span>
            <span class="h2">I’m looking for work.</span>
            <span class="small soft">Register once. It is always free.</span>
            <span class="label ct__go">{cta.candidate.label}<Arrow /></span>
          </a>
        </li>
      </ul>

      <div class="ct__form"><ContactForm /></div>

      <aside class="ct__side" aria-label="Company details">
        <h2 class="label label--soft">Company</h2>
        <address class="ct__addr">
          <span>{site.legalName}</span>
          <span>Commercial Registration No. {site.cr}</span>
          {site.address.length > 0 ? site.address.map((l) => <span>{l}</span>) : <span>{site.city}, {site.country}</span>}
        </address>
        {hasDetails && (
          <ul class="ct__lines">
            {site.email && <li><a class="tlink" href={`mailto:${site.email}`}>{site.email}</a></li>}
            {site.phone && <li><a class="tlink" href={`tel:${site.phone.replace(/\s+/g, '')}`}>{site.phone}</a></li>}
            {site.whatsapp && <li><a class="tlink" href={`https://wa.me/${site.whatsapp}`} rel="noopener">WhatsApp</a></li>}
          </ul>
        )}
      </aside>
    </div>
  </section>
</Base>

<style>
  .ct { padding-block-end: var(--space); }
  .ct__doors { grid-column: 3 / -1; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gutter); margin-block-end: var(--space); }
  .ct__door { display: grid; gap: 0.9rem; align-content: start; block-size: 100%; padding: 1.75rem; border: 1px solid var(--line-strong); transition: background-color var(--d-state) ease, color var(--d-state) ease, border-color var(--d-state) ease; }
  .ct__door:hover, .ct__door:focus-visible { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .ct__door:hover .soft, .ct__door:hover .label--soft, .ct__door:focus-visible .soft, .ct__door:focus-visible .label--soft { color: rgba(238, 232, 222, 0.7); }
  .ct__go { display: inline-flex; align-items: center; gap: 0.9em; margin-block-start: 1rem; }
  .ct__form { grid-column: 3 / span 6; }
  .ct__side { grid-column: 10 / -1; display: grid; gap: 1rem; align-content: start; }
  .ct__addr { display: grid; gap: 0.2rem; font-style: normal; font-size: var(--t-small); line-height: 1.55; }
  .ct__lines { display: grid; gap: 0.25rem; font-size: var(--t-small); }
  @media (max-width: 1023px) {
    .ct__doors, .ct__form, .ct__side { grid-column: 1 / -1; }
    .ct__side { margin-block-start: var(--space-s); }
  }
  @media (max-width: 699px) { .ct__doors { grid-template-columns: 1fr; } }
</style>
