---
/**
 * The homepage: one continuous film after the hero. Every scene is born inside the previous one.
 * See docs/redesign/02-DIRECTION-V3.md §6 for the scene list and the reference behind each.
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/hero/Hero.astro';
import Portal from '../components/scenes/Portal.astro';
import Held from '../components/scenes/Held.astro';
import Workforces from '../components/scenes/Workforces.astro';
import Sectors from '../components/scenes/Sectors.astro';
import Engagement from '../components/scenes/Engagement.astro';
import Expect from '../components/scenes/Expect.astro';
import Employers from '../components/scenes/Employers.astro';
import Candidates from '../components/scenes/Candidates.astro';
import '../styles/scenes.css';
---
<Base home skipTo="#company">
  <div class="opening" data-opening>
    <Hero />
    <Portal />
  </div>
  <Held />
  <Workforces />
  <Sectors />
  <Engagement />
  <Expect />
  <Employers />
  <Candidates />
</Base>
