---
/**
 * Request workforce — the employer conversion.
 *
 * The form engine is unchanged (src/scripts/forms.ts): steps, validation, an error summary, ?workforce= and
 * ?sector= prefill, and the labelled preview mode while no endpoint is configured. Only the setting is new:
 * the stone chapter, the hairline grid, and a sticky column that says what happens after you press send.
 */
import Base from '../layouts/Base.astro';
import PageHead from '../components/ui/PageHead.astro';
import Arrow from '../components/ui/Arrow.astro';
import RequestForm from '../components/forms/RequestForm.astro';
import { site } from '../data/site';

const next = [
  'We review the details you send.',
  'A member of our team contacts you to confirm scope, roles and timing.',
  'You receive a proposal to approve before anything proceeds.',
];
---
<Base title="Request workforce" description="Tell Nexora the roles, numbers and dates you need staffed in Qatar. Two short steps, no commitment." theme="dark">
  <PageHead
    label="For employers"
    title={['Tell us *who*', 'you need.']}
    lead="Two short steps. Rough answers are fine; we confirm the detail with you before anything proceeds."
    meta={[
      { k: 'Steps', v: 'Two' },
      { k: 'Commitment', v: 'None at this stage' },
      { k: 'Reply', v: 'From a named coordinator' },
    ]}
  />

  <section class="rq surface ch-stone" data-theme="paper" aria-label="Requirement form">
    <div class="wrap">
      <div class="rq__grid">
        <div class="rq__form"><RequestForm /></div>

        <aside class="rq__aside" aria-labelledby="rq-next">
          <h2 id="rq-next" class="label rq__h">What happens next</h2>
          <ol class="rq__next">
            {next.map((t, i) => (
              <li class="rq__step"><span class="label rq__n">{String(i + 1).padStart(2, '0')}</span><span class="mono rq__st">{t}</span></li>
            ))}
          </ol>
          <div class="rq__alt">
            <h2 class="label rq__h">Prefer a conversation?</h2>
            <p class="mono rq__st">Send a short message and we will arrange a call.</p>
            <a class="tlink label" href="/contact/">Contact us<Arrow /></a>
            {site.phone && <a class="tlink label" href={`tel:${site.phone.replace(/\s+/g, '')}`}>{site.phone}</a>}
            {site.whatsapp && <a class="tlink label" href={`https://wa.me/${site.whatsapp}`} rel="noopener">WhatsApp</a>}
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>

<style>
  .rq { padding-block: clamp(3rem, 8vh, 5rem) clamp(5rem, 13vh, 10rem); }
  .rq__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: start; border-block-start: 1px solid var(--line-strong); padding-block-start: clamp(2.5rem, 6vh, 4rem); }
  .rq__form { grid-column: 1 / 8; }
  .rq__aside { grid-column: 9 / 13; position: sticky; inset-block-start: calc(var(--header-h) + 2rem); display: grid; gap: 1.25rem; }
  .rq__h { color: var(--fg-soft); }
  .rq__step { display: grid; grid-template-columns: 2.5rem 1fr; align-items: baseline; padding-block: 0.9rem; border-block-start: 1px solid var(--line); }
  .rq__step:last-child { border-block-end: 1px solid var(--line); }
  .rq__n { color: var(--bronze-deep); }
  .rq__st { font-size: 0.75rem; line-height: 1.6; color: var(--fg-soft); }
  .rq__alt { display: grid; gap: 0.6rem; justify-items: start; margin-block-start: 1.5rem; }
  @media (max-width: 1023px) {
    .rq__grid { grid-template-columns: 1fr; row-gap: clamp(2.5rem, 6vh, 4rem); }
    .rq__form, .rq__aside { grid-column: 1; }
    .rq__aside { position: static; }
  }
</style>
