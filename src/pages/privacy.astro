---
/**
 * Plain-language notice limited to what this site actually does. It is a working draft and MUST be
 * reviewed by the client's counsel before launch (see docs/implementation/06).
 */
import Base from '../layouts/Base.astro';
import PageHead from '../components/ui/PageHead.astro';
import { site } from '../data/site';
---
<Base title="Privacy" description="How Nexora Hospitality and Services W.L.L. collects and uses personal information submitted through this website." theme="paper">
  <PageHead label="Privacy" title={['What we collect,', 'and why.']} lead="This notice covers the information you give us through the forms on this website." />

  <section class="pv surface" data-theme="paper">
    <div class="wrap grid">
      <div class="pv__body">
        <h2 class="h3">Who we are</h2>
        <p>{site.legalName}, Commercial Registration No. {site.cr}, {site.city}, {site.country}, is responsible for the personal information collected through this website.</p>

        <h2 class="h3">What we collect</h2>
        <ul>
          <li><strong>Employer requests:</strong> your name, company, work email, phone number and the details of the staffing requirement you describe.</li>
          <li><strong>Candidate registrations:</strong> your name, email, mobile number, country of residence, optional nationality, the kind of work you want, your role or skills, experience, availability and the CV you upload.</li>
          <li><strong>General messages:</strong> your name, email and message.</li>
        </ul>
        <p>We do not ask for passport or ID numbers, photographs, dates of birth, or information about health, religion or family status, and we ask you not to include these in a CV you send us.</p>

        <h2 class="h3">Why we use it</h2>
        <ul>
          <li>To respond to employers and prepare staffing proposals.</li>
          <li>To assess candidates for work opportunities and, with their consent, share their details with prospective employers for that purpose.</li>
          <li>To reply to general enquiries.</li>
        </ul>
        <p>We do not sell personal information, and we do not use it for marketing unless you have separately asked us to send you role alerts.</p>

        <h2 class="h3">Your choices</h2>
        <p>You can ask us to show you, correct or delete the information we hold about you, and you can withdraw your consent at any time. Withdrawing consent does not affect anything done before you withdrew it.</p>

        <h2 class="h3">This website</h2>
        <p>This site does not use advertising or analytics cookies. Fonts and media are served from this website, not from third parties.</p>

        <h2 class="h3">Contact</h2>
        {site.email
          ? <p>For any privacy request, write to <a class="tlink" href={`mailto:${site.email}`}>{site.email}</a>.</p>
          : <p>For any privacy request, use the form on our <a class="tlink" href="/contact/">contact page</a>.</p>}
      </div>
    </div>
  </section>
</Base>

<style>
  .pv { padding-block-end: var(--space); }
  .pv__body { grid-column: 3 / span 7; display: grid; gap: 1.1rem; }
  .pv__body h2 { margin-block-start: 2rem; padding-block-start: 1.5rem; border-block-start: 1px solid var(--line); }
  .pv__body h2:first-child { margin-block-start: 0; }
  .pv__body ul { display: grid; gap: 0.6rem; padding-inline-start: 1.1rem; list-style: square; }
  .pv__body li::marker { color: var(--bronze-deep); }
  .pv__body p, .pv__body li { max-inline-size: 40rem; color: var(--ink); }
  @media (max-width: 1023px) { .pv__body { grid-column: 1 / -1; } }
</style>
