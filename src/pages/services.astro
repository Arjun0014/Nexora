---
/**
 * Services — the five workforces at full depth.
 *
 * One chapter per workforce, alternating ember and stone so the page keeps the homepage's evolving grade
 * rather than repeating a template. Each chapter is the same three things: the plate, the argument, the roles.
 */
import Base from '../layouts/Base.astro';
import PageHead from '../components/ui/PageHead.astro';
import Arrow from '../components/ui/Arrow.astro';
import Doors from '../components/chapters/Doors.astro';
import { worlds } from '../data/worlds';
import { engagements } from '../data/content';

const srcset = (id: string, fmt: string) => [800, 1200, 1672].map((w) => `/media/stills/${id}-${w}.${fmt} ${w}w`).join(', ');
---
<Base title="Services" description="The five kinds of workforce Nexora supplies in Qatar — hospitality, events, facilities, technical and recruitment — and the four ways to engage them." theme="dark">
  <PageHead
    label="Services"
    title={['What we supply,', 'and how.']}
    lead="Five kinds of workforce, engaged in four ways, coordinated from Doha."
    meta={[
      { k: 'Workforces', v: 'Hospitality · Events · Facilities · Technical · Recruitment' },
      { k: 'Engagements', v: 'Short-term · Contract · Project · Permanent' },
      { k: 'Based in', v: 'Doha, Qatar' },
    ]}
  >
    <nav class="sv__index" aria-label="On this page">
      {worlds.map((w) => (
        <a class="sv__jump" href={`#${w.id}`}><span class="label sv__jn">{w.n}</span><span class="sv__jt">{w.short}</span></a>
      ))}
      <a class="sv__jump" href="#engage"><span class="label sv__jn">06</span><span class="sv__jt">Ways to engage</span></a>
    </nav>
  </PageHead>

  {worlds.map((w, i) => (
    <section class={`sv surface ${i % 2 ? 'ch-stone' : 'ch-ember lit grain'}`} id={w.id} data-theme={i % 2 ? 'paper' : 'dark'} data-sector={w.id} aria-labelledby={`${w.id}-h`} data-reveal>
      <div class="sv__wrap wrap">
        <div class="sv__grid">
          <p class="label sv__label" data-rise>{w.n} — Workforce</p>

          <h2 id={`${w.id}-h`} class="sv__title lines">
            {w.titleLines.map((l, k) => <span class="l" style={`--i:${k}`}><span>{l}</span></span>)}
          </h2>

          <p class="lead sv__line" data-rise style="--i:2">{w.line}</p>
          <p class="sv__body" data-rise style="--i:3">{w.body}</p>

          <figure class="sv__plate" data-rise style="--i:2">
            <picture>
              <source type="image/avif" srcset={srcset(w.id, 'avif')} sizes="(max-width: 1023px) 100vw, 52vw" />
              <img src={`/media/stills/${w.id}-1200.webp`} srcset={srcset(w.id, 'webp')} sizes="(max-width: 1023px) 100vw, 52vw" width="1672" height="941" alt={w.alt} loading="lazy" decoding="async" style={`object-position:${w.focus}`} />
            </picture>
            <figcaption class="label sv__cap">{w.frozen}</figcaption>
          </figure>

          <div class="sv__roles" data-rise style="--i:4">
            <p class="label sv__rh">Typical roles</p>
            <ul class="sv__rlist">
              {w.roles.map((r) => <li class="mono sv__role">{r}</li>)}
            </ul>
            <a class="tlink label sv__cta" href={`/request/?workforce=${w.id}`}>Request this workforce<Arrow /></a>
          </div>
        </div>
      </div>
    </section>
  ))}

  <section class="eg surface ch-linen" id="engage" data-theme="paper" aria-labelledby="eg-h" data-reveal>
    <div class="wrap">
      <header class="eg__head">
        <p class="label eg__label" data-rise>Ways to engage</p>
        <h2 id="eg-h" class="eg__h display" data-rise style="--i:1">Four shapes of work.</h2>
      </header>
      <ol class="eg__rows">
        {engagements.map((e, i) => (
          <li class="eg__row">
            <span class="label eg__n">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="eg__t">{e.title}</h3>
            <p class="eg__b">{e.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Doors />
</Base>

<style>
  /* The index inside the page head: hairline cells, not a bulleted list. */
  .sv__index { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); border-block-start: 1px solid var(--line); margin-block-start: clamp(2rem, 6vh, 4rem); }
  .sv__jump { display: grid; gap: 0.6rem; padding: 1.1rem 0.9rem 1.4rem; border-block-end: 1px solid var(--line); border-inline-end: 1px solid var(--line); transition: background-color var(--d-state) ease, color var(--d-state) ease; }
  .sv__jump:last-child { border-inline-end: 0; }
  .sv__jump:hover, .sv__jump:focus-visible { background: rgba(243, 237, 227, 0.06); }
  .sv__jn { color: var(--bronze); }
  .sv__jt { font-family: var(--f-display); font-size: clamp(1rem, 1.35vw, 1.25rem); line-height: 1.1; }

  .sv { padding-block: clamp(4.5rem, 12vh, 9rem); overflow: clip; }
  .sv__wrap { position: relative; z-index: 1; }
  .sv__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: start; }

  .sv__label { grid-column: 1 / 3; color: var(--fg-soft); padding-block: 0.9rem 0; border-block-start: 1px solid var(--line); }
  .sv__title { grid-column: 1 / 7; grid-row: 2; font-family: var(--f-display); font-size: clamp(2.25rem, 5vw, 5rem); line-height: 0.95; letter-spacing: -0.03em; margin-block-start: clamp(1rem, 3vh, 2rem); }
  .sv__line { grid-column: 1 / 6; grid-row: 3; margin-block-start: 1.5rem; }
  .sv__body { grid-column: 1 / 6; grid-row: 4; margin-block-start: 1.25rem; color: var(--fg-soft); }
  .sv__plate { grid-column: 7 / 13; grid-row: 2 / 5; margin-block-start: clamp(1rem, 3vh, 2rem); }
  .sv__plate img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .sv__cap { margin-block-start: 0.85rem; padding-block-start: 0.85rem; border-block-start: 1px solid var(--line); color: var(--fg-soft); }
  .sv__roles { grid-column: 1 / 13; grid-row: 5; margin-block-start: clamp(2rem, 5vh, 3.5rem); }
  .sv__rh { color: var(--fg-soft); padding-block-end: 0.9rem; border-block-end: 1px solid var(--line); }
  .sv__rlist { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--gutter); }
  .sv__role { font-size: 0.75rem; line-height: 1.5; padding-block: 0.65rem; border-block-end: 1px solid var(--line-soft); color: var(--fg-soft); }
  .sv__cta { margin-block-start: 1.75rem; }

  .eg { padding-block: clamp(4.5rem, 12vh, 9rem); }
  .eg__head { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: start; padding-block-end: clamp(2rem, 5vh, 3.5rem); }
  .eg__label { grid-column: 1 / 3; color: var(--fg-soft); padding-block-start: 0.55em; }
  .eg__h { grid-column: 3 / 11; font-size: clamp(2rem, 5vw, 5rem); line-height: 0.95; }
  .eg__rows { border-block-start: 1px solid var(--line-strong); }
  .eg__row { display: grid; grid-template-columns: 3.5rem minmax(0, 5fr) minmax(0, 7fr); column-gap: var(--gutter); align-items: baseline; padding-block: clamp(1.5rem, 3.5vh, 2.5rem); border-block-end: 1px solid var(--line); }
  .eg__n { color: var(--bronze-deep); }
  .eg__t { font-family: var(--f-display); font-size: clamp(1.375rem, 2.6vw, 2.25rem); line-height: 1.05; letter-spacing: -0.02em; }
  .eg__b { color: var(--fg-soft); }

  @media (max-width: 1023px) {
    .sv__index { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .sv__jump:nth-child(3n) { border-inline-end: 0; }
    .sv__grid { grid-template-columns: repeat(8, minmax(0, 1fr)); }
    .sv__label { grid-column: 1 / 5; }
    .sv__title { grid-column: 1 / 9; }
    .sv__plate { grid-column: 1 / 9; grid-row: 3; margin-block: 1.75rem 0; }
    .sv__line { grid-row: 4; }
    .sv__body { grid-row: 5; }
    .sv__roles { grid-column: 1 / 9; grid-row: 6; }
    .sv__rlist { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .eg__head { grid-template-columns: repeat(8, minmax(0, 1fr)); row-gap: 1rem; }
    .eg__label, .eg__h { grid-column: 1 / 9; }
    .eg__row { grid-template-columns: 3rem minmax(0, 1fr); row-gap: 0.6rem; }
    .eg__b { grid-column: 2 / 3; }
  }
  @media (max-width: 699px) {
    .sv__index { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .sv__jump:nth-child(3n) { border-inline-end: 1px solid var(--line); }
    .sv__jump:nth-child(2n) { border-inline-end: 0; }
    .sv__rlist { grid-template-columns: 1fr; }
  }
</style>
