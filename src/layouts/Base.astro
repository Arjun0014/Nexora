---
import '@fontsource-variable/noto-serif-display/wdth.css';
import '@fontsource-variable/noto-serif-display/wdth-italic.css';
import '@fontsource-variable/archivo/wdth.css';
import '../styles/tokens.css';
import '../styles/base.css';

import serifUrl from '@fontsource-variable/noto-serif-display/files/noto-serif-display-latin-wdth-normal.woff2?url';
import sansUrl from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';

import Header from '../components/Header.astro';
import MenuSheet from '../components/MenuSheet.astro';
import Footer from '../components/Footer.astro';
import Intro from '../components/Intro.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  home?: boolean;
  /** Surface of the first section, so the header starts with the right ink. */
  theme?: 'dark' | 'paper';
  noindex?: boolean;
  skipTo?: string;
}
const { title, description = site.description, home = false, theme = 'dark', noindex = false, skipTo = '#main' } = Astro.props;

const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline} Workforce solutions in Qatar`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/media/og.jpg', Astro.site).href;

// Structured data carries ONLY confirmed facts. No telephone/address until the client supplies them.
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  legalName: site.legalName,
  url: new URL('/', Astro.site).href,
  description: site.description,
  foundingDate: site.foundingDate,
  address: { '@type': 'PostalAddress', addressLocality: site.city, addressCountry: 'QA' },
  areaServed: { '@type': 'Country', name: site.country },
  ...(site.email ? { email: site.email } : {}),
  ...(site.phone ? { telephone: site.phone } : {}),
  ...(site.social.length ? { sameAs: site.social.map((s) => s.href) } : {}),
};
const webSite = { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: new URL('/', Astro.site).href, inLanguage: site.lang };
---
<!doctype html>
<html lang={site.lang} dir={site.dir} data-theme={theme} data-home={home ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={home || theme === 'paper' ? '#eee7db' : '#0b0a09'} />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A carved limestone screen in the Doha sun, a circle of it open onto a man pouring Arabic coffee." />
    <meta property="og:locale" content="en_QA" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href={serifUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansUrl} as="font" type="font/woff2" crossorigin />

    <!--
      Decide the rendering mode BEFORE first paint so the hero never changes layout afterwards (CLS 0)
      and reduced-motion users never see a flash of the pinned stage.
        js      scripting available
        motion  animation allowed (OS preference, overridable by the footer toggle)
        cinema  motion allowed AND the network can afford the film → hero is a pinned, scrubbed stage
    -->
    <script is:inline>
      (function () {
        // A reload always starts at the top, with the film at its first frame (brief #16).
        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        if (!location.hash) window.scrollTo(0, 0);
        var c = document.documentElement.classList;
        c.add('js');
        // The visitor's own choice (footer toggle) overrides the OS setting in either direction.
        var pref = null;
        try { pref = localStorage.getItem('nx-motion'); } catch (e) {}
        var reduce = pref === 'off' || (pref !== 'on' && window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches);
        var n = navigator.connection || {};
        var lite = !!n.saveData || /(^|-)2g$|^3g$/.test(n.effectiveType || '');
        if (!reduce) { c.add('motion'); if (!lite) c.add('cinema'); }
        if (lite) c.add('lite');
        // Arriving through a page transition: the cover is already up before the first paint, and it lifts away.
        var pt = null;
        try { pt = sessionStorage.getItem('nx-pt'); sessionStorage.removeItem('nx-pt'); } catch (e) {}
        if (pt && c.contains('motion')) { document.documentElement.dataset.pt = 'in'; document.documentElement.style.setProperty('--pt-label', JSON.stringify(pt)); }
        // The intro decides itself BEFORE first paint, so the film is never visible for a frame first.
        // Only on the homepage, only when the film will actually run, and never under reduced motion.
        if (document.documentElement.hasAttribute('data-home') && c.contains('cinema') && !pt && !/[?&]nointro\b/.test(location.search) && !/[?&]stop=/.test(location.search)) {
          document.documentElement.dataset.intro = 'on'; // every load and reload; an in-site page change uses the page transition instead
        }
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(org)} />
    <script type="application/ld+json" set:html={JSON.stringify(webSite)} />
    <slot name="head" />
  </head>
  <body>
    {home && <Intro />}
    <a class="skip label" href={skipTo}>Skip to content</a>
    <Header home={home} ink={home || theme === 'paper' ? 'dark' : 'light'} />
    <MenuSheet />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer from={home ? 'maroon' : 'sand'} />
    <!-- The page transition (src/scripts/transition.ts): a maroon circle opens from the click; the next page lifts it away. -->
    <div class="pt" data-pt aria-hidden="true">
      <div class="pt__inner">
        <p class="label pt__k">Nexora</p>
        <p class="display pt__name" data-pt-name></p>
        <span class="pt__line"></span>
      </div>
      <span class="pt__rim" data-pt-rim></span>
    </div>

    <!-- The pointer follower (src/scripts/cursor.ts). Augments the native cursor, never replaces it. -->
    <div class="cursor" data-cursor-root data-state="dot" aria-hidden="true">
      <span class="cursor__disc"></span>
      <svg class="cursor__ring" viewBox="0 0 100 100" focusable="false"><circle cx="50" cy="50" r="48" pathLength="1" /></svg>
      <span class="cursor__label label" data-cursor-text></span>
    </div>

    <script>
      import '../scripts/app';
    </script>
  </body>
</html>

<style is:global>
  main:focus { outline: none; }

  /* ── page transition ───────────────────────────────────────────────────────── */
  .pt {
    --r: 0px; --x: 50vw; --y: 50vh; --lift: 0;
    position: fixed; inset: 0; z-index: 450; pointer-events: none; visibility: hidden;
    background: var(--maroon);
    background-image: radial-gradient(70% 60% at 50% 100%, rgba(208, 149, 96, 0.22), transparent 70%);
    color: var(--bone);
    clip-path: circle(var(--r) at var(--x) var(--y));
  }
  .pt[data-state] { visibility: visible; pointer-events: auto; }
  /* arriving: already covering before the first paint */
  html[data-pt='in'] .pt { visibility: visible; clip-path: none; }
  .pt[data-state='out'] { clip-path: ellipse(120vw calc((1 - var(--lift)) * 160vh) at 50% 0%); }
  .pt__inner { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 1.2rem; text-align: center; translate: 0 calc(var(--lift) * -18vh); opacity: calc(1 - var(--lift) * 1.6); }
  .pt__k { color: var(--amber); opacity: 0; translate: 0 10px; transition: opacity 400ms linear 120ms, translate 800ms var(--ease-out) 120ms; }
  .pt__name { font-size: clamp(3rem, 9vw, 11rem); opacity: 0; translate: 0 0.4em; transition: opacity 500ms linear 180ms, translate 900ms var(--ease-out) 180ms; }
  .pt[data-state] .pt__k, .pt[data-state] .pt__name, html[data-pt='in'] .pt__k, html[data-pt='in'] .pt__name { opacity: 1; translate: 0 0; }
  html[data-pt='in'] .pt__k, html[data-pt='in'] .pt__name { transition: none; }
  html[data-pt='in'] .pt__name:empty::before { content: var(--pt-label, ''); }
  .pt__line { width: 9rem; height: 1px; background: rgba(244, 239, 230, 0.2); position: relative; overflow: hidden; margin-block-start: 0.6rem; }
  .pt__line::after { content: ''; position: absolute; inset: 0; background: var(--amber); transform-origin: left; animation: pt-breathe 1.6s var(--ease-io) infinite; }
  @keyframes pt-breathe { 0% { transform: scaleX(0); transform-origin: left; } 50% { transform: scaleX(1); transform-origin: left; } 50.01% { transform-origin: right; } 100% { transform: scaleX(0); transform-origin: right; } }
  .pt__rim { position: absolute; left: var(--x); top: var(--y); width: calc(var(--r) * 2); height: calc(var(--r) * 2); translate: -50% -50%; border-radius: 50%;
    box-shadow: 0 0 0 1px rgba(240, 189, 134, 0.85), 0 0 36px 4px rgba(208, 149, 96, 0.5); pointer-events: none; }
  .pt[data-state='out'] .pt__rim, html[data-pt='in'] .pt__rim { display: none; }
  /* while the cover lifts, the page underneath settles up into place */
  html[data-pt] main { translate: 0 calc((1 - var(--settle, 1)) * 5vh); }

  /* ── pointer follower ────────────────────────────────────────────────────────
     noho.ink's model: a small disc that eases to the pointer and morphs by context. The disc is laid out at its
     LARGEST size and scaled down, so it is sharp at every size and only transform/opacity animate. */
  .cursor {
    --fill: var(--ink); --ink-on: var(--bone);
    position: fixed; top: 0; left: 0; z-index: 400; width: 0; height: 0;
    pointer-events: none; opacity: 0; transition: opacity 240ms linear;
    will-change: transform;
  }
  .cursor[data-on] { opacity: 1; }
  .cursor[data-ground='dark'] { --fill: var(--bone); --ink-on: var(--ink); }
  .cursor__disc {
    position: absolute; left: -48px; top: -48px; width: 96px; height: 96px; border-radius: 50%;
    background: var(--fill); border: 2px solid transparent;
    transition: transform 420ms cubic-bezier(0.25, 1, 0.5, 1), background-color 300ms ease, border-color 300ms ease;
  }
  .cursor__ring { position: absolute; left: -52px; top: -52px; width: 104px; height: 104px; rotate: -90deg; overflow: visible; opacity: 0; transition: opacity 200ms linear; }
  .cursor__ring circle { fill: none; stroke: var(--amber); stroke-width: 2.5; stroke-dasharray: 1; stroke-dashoffset: calc(1 - var(--hold, 0)); }
  .cursor__label {
    position: absolute; left: 0; top: 0; translate: -50% -50%; white-space: nowrap;
    color: var(--ink-on); font-size: 0.625rem; letter-spacing: 0.14em;
    opacity: 0; scale: 0.6; transition: opacity 200ms linear, scale 420ms cubic-bezier(0.25, 1, 0.5, 1);
  }

  .cursor[data-state='dot'] .cursor__disc { transform: scale(0.125); }
  .cursor[data-state='ring'] .cursor__disc { transform: scale(0.5); background: transparent; border-color: var(--fill); }
  .cursor[data-state='label'] .cursor__disc, .cursor[data-state='hold'] .cursor__disc, .cursor[data-state='drag'] .cursor__disc { transform: scale(1); background: var(--amber); }
  .cursor[data-state='label'] .cursor__label, .cursor[data-state='hold'] .cursor__label, .cursor[data-state='drag'] .cursor__label { opacity: 1; scale: 1; color: var(--ink); transition-delay: 60ms; }
  .cursor[data-state='hold'] .cursor__ring { opacity: 1; }
  .cursor[data-state='num'] .cursor__disc { transform: scale(0.62); background: var(--ink); }
  .cursor[data-state='num'] .cursor__label { opacity: 1; scale: 1; color: var(--bone); }
  .cursor[data-state='hide'] .cursor__disc { transform: scale(0); }
  .cursor[data-press] .cursor__disc { transition-duration: 160ms; }
  .cursor[data-press][data-state='dot'] .cursor__disc { transform: scale(0.09); }
  .cursor[data-press][data-state='ring'] .cursor__disc { transform: scale(0.42); }
  .cursor[data-press][data-state='label'] .cursor__disc, .cursor[data-press][data-state='hold'] .cursor__disc, .cursor[data-press][data-state='drag'] .cursor__disc { transform: scale(0.9); }

  @media (hover: none), (pointer: coarse), (prefers-reduced-motion: reduce) {
    .cursor { display: none; }
  }
</style>
