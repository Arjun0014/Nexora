---
import '@fontsource-variable/noto-serif-display/wdth.css';
import '@fontsource-variable/noto-serif-display/wdth-italic.css';
import '@fontsource-variable/archivo/wdth.css';
import '../styles/tokens.css';
import '../styles/base.css';

import serifUrl from '@fontsource-variable/noto-serif-display/files/noto-serif-display-latin-wdth-normal.woff2?url';
import sansUrl from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';

import Header from '../components/Header.astro';
import MenuSheet from '../components/MenuSheet.astro';
import Footer from '../components/Footer.astro';
import Intro from '../components/Intro.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  home?: boolean;
  /** Surface of the first section, so the header starts with the right ink. */
  theme?: 'dark' | 'paper';
  noindex?: boolean;
  skipTo?: string;
}
const { title, description = site.description, home = false, theme = 'dark', noindex = false, skipTo = '#main' } = Astro.props;

const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline} Workforce solutions in Qatar`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/media/og.jpg', Astro.site).href;

// Structured data carries ONLY confirmed facts. No telephone/address until the client supplies them.
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  legalName: site.legalName,
  url: new URL('/', Astro.site).href,
  description: site.description,
  foundingDate: site.foundingDate,
  address: { '@type': 'PostalAddress', addressLocality: site.city, addressCountry: 'QA' },
  areaServed: { '@type': 'Country', name: site.country },
  ...(site.email ? { email: site.email } : {}),
  ...(site.phone ? { telephone: site.phone } : {}),
  ...(site.social.length ? { sameAs: site.social.map((s) => s.href) } : {}),
};
const webSite = { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: new URL('/', Astro.site).href, inLanguage: site.lang };
---
<!doctype html>
<html lang={site.lang} dir={site.dir} data-theme={theme} data-home={home ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0b0a09" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A circular architectural model divided into five lit sectors, each a different workplace." />
    <meta property="og:locale" content="en_QA" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href={serifUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansUrl} as="font" type="font/woff2" crossorigin />
    {home && <link rel="preload" as="image" href="/media/hero/poster-1440.webp" type="image/webp" fetchpriority="high" media="(min-aspect-ratio: 1/1)" />}
    {home && <link rel="preload" as="image" href="/media/hero/poster-960.webp" type="image/webp" fetchpriority="high" media="(max-aspect-ratio: 999/1000)" />}

    <!--
      Decide the rendering mode BEFORE first paint so the hero never changes layout afterwards (CLS 0)
      and reduced-motion users never see a flash of the pinned stage.
        js      scripting available
        motion  animation allowed (OS preference, overridable by the footer toggle)
        cinema  motion allowed AND the network can afford the film → hero is a pinned, scrubbed stage
    -->
    <script is:inline>
      (function () {
        // A reload always starts at the top, with the film at its first frame (brief #16).
        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        if (!location.hash) window.scrollTo(0, 0);
        var c = document.documentElement.classList;
        c.add('js');
        // The visitor's own choice (footer toggle) overrides the OS setting in either direction.
        var pref = null;
        try { pref = localStorage.getItem('nx-motion'); } catch (e) {}
        var reduce = pref === 'off' || (pref !== 'on' && window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches);
        var n = navigator.connection || {};
        var lite = !!n.saveData || /(^|-)2g$|^3g$/.test(n.effectiveType || '');
        if (!reduce) { c.add('motion'); if (!lite) c.add('cinema'); }
        if (lite) c.add('lite');
        // The intro decides itself BEFORE first paint, so the film is never visible for a frame first.
        // Only on the homepage, only when the film will actually run, and never under reduced motion.
        if (document.documentElement.hasAttribute('data-home') && c.contains('cinema') && !/[?&]nointro\b/.test(location.search) && !/[?&]stop=/.test(location.search)) {
          document.documentElement.dataset.intro = 'on'; // every load, not once per session (brief #16)
        }
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(org)} />
    <script type="application/ld+json" set:html={JSON.stringify(webSite)} />
    <slot name="head" />
  </head>
  <body>
    {home && <Intro />}
    <a class="skip label" href={skipTo}>Skip to content</a>
    <Header home={home} />
    <MenuSheet />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <!-- The pointer follower. Augments the native cursor, never replaces it. -->
    <div class="cursor" data-cursor-root data-state="dot" aria-hidden="true">
      <span class="cursor__dot"></span>
      <span class="cursor__arrow">
        <svg viewBox="0 0 24 12" width="24" height="12" focusable="false"><path d="M0 6h21M15 1l6 5-6 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
      </span>
      <span class="cursor__hand">
        <svg viewBox="0 0 24 24" width="20" height="20" focusable="false"><path d="M7 11V5.5a1.5 1.5 0 0 1 3 0V11m0-1V4.5a1.5 1.5 0 0 1 3 0V11m0-.5V6a1.5 1.5 0 0 1 3 0v5m0-2.5a1.5 1.5 0 0 1 3 0V15a6 6 0 0 1-6 6h-1.5a6 6 0 0 1-5.2-3L5 14.5a1.6 1.6 0 0 1 2.6-1.8L9 14" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </span>
      <span class="cursor__text label" data-cursor-text></span>
      <img class="cursor__img" data-cursor-img alt="" width="160" height="200" hidden />
    </div>

    <script>
      import '../scripts/app';
    </script>
  </body>
</html>

<style is:global>
  main:focus { outline: none; }

  /* ── pointer follower ────────────────────────────────────────────────────────
     One element that morphs: dot, label, arrow, hand, media plate. It augments the
     native cursor (which stays visible), so nothing is lost if it fails to load. */
  .cursor {
    position: fixed; inset-block-start: 0; inset-inline-start: 0; z-index: 180;
    display: grid; place-items: center;
    width: 0; height: 0;
    pointer-events: none; opacity: 0;
    color: var(--studio);
    will-change: transform;
  }
  .cursor > * { grid-area: 1 / 1; transition: opacity 200ms ease, scale 320ms var(--ease-freeze); }
  .cursor__dot, .cursor__arrow, .cursor__hand, .cursor__text, .cursor__img { rotate: var(--counter-rotate, 0deg); }

  .cursor__dot { width: 15px; height: 15px; border-radius: 50%; background: var(--bone); }
  .cursor__arrow, .cursor__hand { display: grid; place-items: center; width: 56px; height: 56px; border-radius: 50%; background: var(--bone); opacity: 0; scale: 0.4; }
  .cursor__text {
    padding: 0.55em 0.9em; border-radius: 999px;
    background: var(--bone); color: var(--studio);
    white-space: nowrap; font-size: 0.625rem; letter-spacing: 0.16em;
    opacity: 0; scale: 0.4;
  }
  .cursor__img { width: 160px; height: 200px; object-fit: cover; opacity: 0; scale: 0.5; box-shadow: 0 24px 60px -24px rgba(0, 0, 0, 0.85); }

  .cursor[data-state='dot'] .cursor__dot { opacity: 1; scale: 1; }
  .cursor:not([data-state='dot']) .cursor__dot { opacity: 0; scale: 0.3; }
  .cursor[data-state='arrow'] .cursor__arrow,
  .cursor[data-state='drag'] .cursor__hand,
  .cursor[data-state='label'] .cursor__text,
  .cursor[data-state='media'] .cursor__img { opacity: 1; scale: 1; }
  /* "Drag" is a hand with a word beside it, so the affordance is named as well as drawn. */
  .cursor[data-state='drag'] .cursor__text { opacity: 1; scale: 1; translate: 0 44px; }
  .cursor[data-press] .cursor__hand { scale: 0.86; }
  .cursor[data-press] .cursor__dot { scale: 0.7; }

  @media (hover: none), (pointer: coarse), (prefers-reduced-motion: reduce) {
    .cursor { display: none; }
  }
</style>
