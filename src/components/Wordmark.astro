---
/**
 * The NEXORA wordmark as outlined vector (generated by scripts/build-wordmark.mjs).
 * The same path drives the hero's title-card mask, so header, mask and footer are identical.
 *
 * `...rest` matters: Astro scopes a parent's styles with a data-astro-cid attribute, and a class passed
 * to a child component only matches if that attribute is forwarded too.
 */
import wordmark from '../data/wordmark.json';
interface Props { class?: string; title?: boolean; [key: string]: unknown }
const { class: className, title = true, ...rest } = Astro.props;
---
<svg class={className} viewBox={`0 0 ${wordmark.width} ${wordmark.height}`} fill="currentColor" role={title ? 'img' : undefined} aria-label={title ? 'Nexora' : undefined} aria-hidden={title ? undefined : 'true'} focusable="false" {...rest}>
  <path d={wordmark.d}></path>
</svg>
