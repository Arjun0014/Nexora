---
/**
 * A chapter boundary.
 *
 * The word is knocked out of the outgoing chapter's ground, so the next chapter is already showing through its
 * letterforms; scrolling flies into one letter until that is all there is. Driven by src/scripts/zoom.ts.
 *
 * Without JS or motion it is a still composition — the word filled with the next chapter's picture — which is
 * a perfectly good section in its own right.
 */
interface Props {
  /** Must exist in src/data/words.json (npm run words). */
  word: 'WORKFORCES' | 'SECTORS';
  /** The outgoing chapter's ground, as a hex string: the canvas fills with it. */
  ground: string;
  /** Slug of the still revealed through the letters, or a flat colour. */
  image?: string;
  colour?: string;
  label: string;
  caption?: string;
  focus?: string;
}
const { word, ground, image, colour, label, caption, focus = '50% 50%' } = Astro.props;
const srcset = (id: string, fmt: string) => [800, 1200, 1672].map((w) => `/media/stills/${id}-${w}.${fmt} ${w}w`).join(', ');
---
<section class="zg" data-zoom={word} data-zoom-ground={ground} aria-labelledby={`zg-${word}`}>
  <div class="zg__stage" data-zoom-stage>
    <div class="zg__next" data-zoom-next>
      {image ? (
        <>
          <picture class="zg__pic">
            <source type="image/avif" srcset={srcset(image, 'avif')} sizes="100vw" />
            <img src={`/media/stills/${image}-1200.webp`} srcset={srcset(image, 'webp')} sizes="100vw" width="1672" height="941" alt="" loading="lazy" decoding="async" style={`object-position:${focus}`} />
          </picture>
          <!-- A statically blurred copy, cross-faded out: the arrival resolves focus instead of fading in. -->
          <img class="zg__pic zg__soft" data-zoom-soft src={`/media/stills/${image}-800.webp`} width="1672" height="941" alt="" loading="lazy" decoding="async" style={`object-position:${focus}`} />
        </>
      ) : (
        <div class="zg__flat" style={`background:${colour}`}></div>
      )}
    </div>

    <canvas class="zg__mask" data-zoom-mask aria-hidden="true"></canvas>

    <div class="zg__ui">
      <p class="label zg__label">{label}</p>
      <h2 id={`zg-${word}`} class="zg__word">{word.charAt(0) + word.slice(1).toLowerCase()}</h2>
      {caption && <p class="label zg__caption">{caption}</p>}
    </div>
  </div>
</section>

<style>
  /* The track is what the transition is scrubbed against; the stage is what you see. */
  .zg { position: relative; height: 240vh; background: var(--zg-ground, var(--ember)); }
  .zg__stage { position: sticky; inset-block-start: 0; height: 100vh; height: 100svh; overflow: clip; contain: layout paint; isolation: isolate; }

  .zg__next { position: absolute; inset: 0; transform-origin: 50% 50%; will-change: transform; }
  .zg__pic { position: absolute; inset: 0; }
  .zg__pic img, .zg__flat { width: 100%; height: 100%; object-fit: cover; }
  .zg__flat { position: absolute; inset: 0; }
  .zg__soft { width: 100%; height: 100%; object-fit: cover; filter: blur(22px); transform: scale(1.08); opacity: 1; }

  .zg__mask { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 2; pointer-events: none; }

  .zg__ui { position: absolute; inset: 0; z-index: 3; pointer-events: none; color: var(--bone); }
  .zg__label { position: absolute; inset-block-start: clamp(1.5rem, 6vh, 3rem); inset-inline-start: var(--margin); color: var(--bone-soft); transition: opacity 400ms ease; }
  .zg__caption { position: absolute; inset-block-end: clamp(1.5rem, 6vh, 3rem); inset-inline-end: var(--margin); color: var(--bone-soft); text-align: right; max-width: 22rem; transition: opacity 400ms ease; }
  /* The chrome holds still while the type flies, then leaves once the letters own the stage. */
  .zg[data-state='run'] .zg__label, .zg[data-state='run'] .zg__caption { opacity: 0.5; }
  .zg[data-state='done'] .zg__label, .zg[data-state='done'] .zg__caption { opacity: 0; }

  /* The canvas carries the word once JS is running, so the real heading is for assistive tech only. */
  .zg__word { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  /* Without JS there is no canvas: the word is set as type across the picture instead. */
  :global(html:not(.js)) .zg__word {
    position: static; width: auto; height: auto; margin: 0; overflow: visible; clip-path: none;
    display: grid; place-items: center; block-size: 100%;
    font-family: var(--f-display); font-size: clamp(3rem, 13vw, 14rem); line-height: 1;
    letter-spacing: -0.035em; text-transform: uppercase; color: var(--bone);
    text-shadow: 0 2px 60px rgba(11, 10, 9, 0.8);
  }
  :global(html:not(.js)) .zg__ui { display: grid; }

  /* No JS or no motion: one still composition, no track to scrub. */
  :global(html:not(.motion)) .zg { height: 100svh; }
  :global(html:not(.motion)) .zg__soft { display: none; }
</style>
