---
/**
 * Chapter IV-b — how an engagement runs.
 *
 * Five stations down a drawn path, with ONE picture beside them that resolves from a drawing into the lit
 * render as you pass each station (Kononenko's increasing fidelity). No numbered boxes, no icons: the image
 * itself shows the progress, because the picture is the Nexora model becoming real.
 */
import { process } from '../../data/content';

const srcset = (fmt: string) => [800, 1200, 1672].map((w) => `/media/stills/overview-${w}.${fmt} ${w}w`).join(', ');
---
<section class="pr surface ch-linen" id="process" data-theme="paper" data-chapter-name="How it runs" data-process aria-labelledby="pr-h" data-reveal>
  <div class="pr__wrap wrap">
    <header class="pr__head">
      <p class="label pr__label" data-rise style="--i:0">{process.label}</p>
      <h2 id="pr-h" class="pr__h display lines">
        {process.heading.map((l, i) => (
          <span class="l" style={`--i:${i}`}><span class={i ? 'recede' : ''}>{l}</span></span>
        ))}
      </h2>
      <p class="pr__intro lead" data-rise style="--i:3">{process.intro}</p>
    </header>

    <div class="pr__body">
      <ol class="pr__stations">
        {process.steps.map((s, i) => (
          <li class="pr__station" data-station data-on={i === 0 ? 'true' : 'false'} data-current={i === 0 ? 'true' : 'false'}>
            <span class="pr__tick" data-process-tick aria-hidden="true"></span>
            <p class="label pr__n">{s.n}</p>
            <h3 class="pr__t">{s.title}</h3>
            <p class="pr__b">{s.body}</p>
            <p class="pr__approve mono"><span class="pr__ak">You approve</span>{s.approve}</p>
          </li>
        ))}
      </ol>

      <!-- One picture, five states. It is sticky, so the stations pass it. -->
      <figure class="pr__figure">
        <!-- Starts finished: JS drops it back to the blueprint on boot, so without JS the render stands. -->
          <div class="pr__frame" data-process-figure data-stage="4">
          <picture>
            <source type="image/avif" srcset={srcset('avif')} sizes="(max-width: 1023px) 90vw, 38vw" />
            <img src="/media/stills/overview-1200.webp" srcset={srcset('webp')} sizes="(max-width: 1023px) 90vw, 38vw" width="1672" height="941" alt="The Nexora model: one circular platform divided into five lit sectors." loading="lazy" decoding="async" />
          </picture>
          <span class="pr__grid" aria-hidden="true"></span>
        </div>
        <figcaption class="label pr__cap">
          <span class="pr__capk">Fidelity</span>
          <span class="pr__capv" data-process-caption>Brief → people on site</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .pr { padding-block: clamp(5rem, 12vh, 9rem) clamp(6rem, 15vh, 11rem); background: var(--linen); }

  .pr__head { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: start; padding-block-end: clamp(2.5rem, 6vh, 4rem); border-block-end: 1px solid var(--line); }
  .pr__label { grid-column: 1 / 3; color: var(--fg-soft); padding-block-start: 0.55em; }
  .pr__h { grid-column: 3 / 9; font-size: clamp(2rem, 4.8vw, 5rem); line-height: 0.95; }
  .pr__intro { grid-column: 9 / 13; align-self: end; color: var(--fg-soft); font-size: var(--t-body); }

  .pr__body { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); column-gap: clamp(2rem, 5vw, 5rem); margin-block-start: clamp(2.5rem, 6vh, 4.5rem); }

  /* ── the stations, strung along a drawn path ── */
  .pr__stations { grid-column: 1; position: relative; padding-inline-start: 2.5rem; }
  .pr__stations::before { content: ''; position: absolute; inset-block: 1.6rem 0; inset-inline-start: 0.4rem; width: 1px; background: var(--line); }
  .pr__station { position: relative; padding-block: clamp(2rem, 5vh, 3.25rem); border-block-end: 1px solid var(--line); opacity: 0.4; transition: opacity var(--d-reveal) ease; }
  .pr__tick { position: absolute; inset-block-start: clamp(2.1rem, 5.1vh, 3.35rem); inset-inline-start: -2.35rem; width: 9px; height: 9px; border-radius: 50%; background: var(--linen); border: 1px solid var(--line-strong); transition: background-color var(--d-reveal) ease, border-color var(--d-reveal) ease, scale var(--d-reveal) var(--ease-freeze); }
  .pr__station[data-on='true'] .pr__tick { background: var(--bronze-deep); border-color: var(--bronze-deep); }
  .pr__station[data-current='true'] .pr__tick { scale: 1.45; }
  .pr__station[data-on='true'] { opacity: 1; }
  .pr__n { color: var(--fg-soft); }
  .pr__station[data-current='true'] .pr__n { color: var(--bronze-deep); }
  .pr__t { font-family: var(--f-display); font-size: clamp(1.5rem, 2.8vw, 2.5rem); line-height: 1.05; letter-spacing: -0.02em; margin-block: 0.75rem 0.75rem; }
  .pr__b { max-width: 28rem; color: var(--fg-soft); }
  .pr__approve { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; margin-block-start: 1.25rem; font-size: 0.75rem; }
  .pr__ak { color: var(--fg-soft); text-transform: uppercase; letter-spacing: 0.14em; }

  /* ── the picture ── */
  .pr__figure { grid-column: 2; position: sticky; inset-block-start: calc(var(--header-h) + clamp(1.5rem, 6vh, 4rem)); align-self: start; margin-block-start: clamp(2rem, 5vh, 3.25rem); }
  .pr__frame { position: relative; overflow: clip; background: var(--stone); isolation: isolate; }
  .pr__frame img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; transition: filter 900ms var(--ease-io), transform 900ms var(--ease-io); }

  /* Stage 0 is a drawing; by stage 4 it is the lit render. One image, five fidelities. */
  .pr__frame[data-stage='0'] img { filter: grayscale(1) invert(1) brightness(1.5) contrast(3.4); transform: scale(1.02); }
  .pr__frame[data-stage='1'] img { filter: grayscale(1) contrast(1.85) brightness(1.05); transform: scale(1.015); }
  .pr__frame[data-stage='2'] img { filter: grayscale(0.7) contrast(1.25); transform: scale(1.01); }
  .pr__frame[data-stage='3'] img { filter: grayscale(0.25) saturate(0.85); transform: scale(1.005); }
  .pr__frame[data-stage='4'] img { filter: none; transform: none; }

  /* The drafting grid is only there while the picture is still a drawing. */
  .pr__grid { position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity 900ms var(--ease-io);
    background-image: linear-gradient(to right, rgba(21, 18, 15, 0.16) 1px, transparent 1px), linear-gradient(to bottom, rgba(21, 18, 15, 0.16) 1px, transparent 1px);
    background-size: 44px 44px; }
  .pr__frame[data-stage='0'] .pr__grid { opacity: 1; }
  .pr__frame[data-stage='1'] .pr__grid { opacity: 0.45; }

  .pr__cap { display: flex; justify-content: space-between; gap: 1rem; margin-block-start: 0.9rem; padding-block-start: 0.9rem; border-block-start: 1px solid var(--line); color: var(--fg-soft); }

  @media (max-width: 1023px) {
    .pr__head { grid-template-columns: repeat(8, minmax(0, 1fr)); row-gap: 1.25rem; }
    .pr__label, .pr__h, .pr__intro { grid-column: 1 / 9; }
    .pr__body { grid-template-columns: 1fr; }
    .pr__figure { grid-column: 1; grid-row: 1; position: static; margin-block: 0 clamp(2rem, 5vh, 3rem); }
    .pr__stations { grid-column: 1; grid-row: 2; }
  }
  @media (max-width: 699px) {
    .pr__stations { padding-inline-start: 1.75rem; }
    .pr__tick { inset-inline-start: -1.6rem; }
    .pr__frame img { aspect-ratio: 4 / 3; }
  }

  /* No JS: every station is simply legible and the picture is the finished render. */
  :global(html:not(.js)) .pr__station { opacity: 1; }
</style>
