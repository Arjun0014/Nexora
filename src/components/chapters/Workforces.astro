---
/**
 * Chapter II — the five workforces, as a stack of plates you can throw.
 *
 * The stack carries only the picture and the name (lxlcreative: label bottom-left, arrow bottom-right); the
 * copy that has to be read sits beside it and swaps with the front card. The ground takes a 6% tint of the
 * active world's colour, so the chapter's colour changes as you deal through it (ERA).
 *
 * Without JS or motion the same markup is a plain ordered list of five figures with all the copy visible.
 */
import Arrow from '../ui/Arrow.astro';
import { worlds } from '../../data/worlds';

// The 4:5 action crops built by scripts/build-media.mjs; 720 is the source ceiling (753 px wide).
const srcset = (id: string, fmt: string) => [480, 720].map((w) => `/media/stills/${id}-card-${w}.${fmt} ${w}w`).join(', ');
const sizes = '(max-width: 1023px) 86vw, 34vw';
---
<section class="wf surface ch-deck grain" id="workforces" data-theme="dark" data-chapter-name="Five workforces" data-deck aria-labelledby="wf-h" data-cursor-zone="deck">
  <div class="wf__wrap wrap">
    <header class="wf__head">
      <p class="label wf__label">Five workforces</p>
      <h2 id="wf-h" class="sr-only">The five workforces Nexora supplies</h2>
      <p class="label wf__count" data-n="1"><span data-deck-count>01</span><span class="wf__of">/ 0{worlds.length}</span></p>
    </header>

    <div class="wf__body">
      <!-- The readable half: one panel per world, swapped with the front card. -->
      <div class="wf__panels">
        {worlds.map((w, i) => (
          <article class="wf__panel" data-deck-panel={w.id} data-sector={w.id} data-on={i === 0 ? 'true' : 'false'}>
            <h3 class="wf__title display">{w.titleLines.map((l) => <span class="wf__tl">{l}</span>)}</h3>
            <p class="wf__line lead">{w.line}</p>
            <ul class="wf__roles">
              {w.roles.map((r) => <li class="mono wf__role">{r}</li>)}
            </ul>
            <a class="tlink label wf__cta" href={`/services/#${w.id}`}>{w.linkLabel}<Arrow /></a>
          </article>
        ))}
      </div>

      <!-- The stack. In the static fallback this is an ordinary list of plates. -->
      <div class="wf__deck">
        <ol class="wf__stack" data-deck-stack tabindex="0" role="group" aria-label="Workforce plates — use the arrow keys or drag to change">
          {worlds.map((w, i) => (
            <li class="wf__card" data-deck-card={w.id} data-deck-title={w.title} data-sector={w.id} style={`--k:${i}`}>
              <picture>
                <source type="image/avif" srcset={srcset(w.id, 'avif')} sizes={sizes} />
                <img src={`/media/stills/${w.id}-card-720.webp`} srcset={srcset(w.id, 'webp')} sizes={sizes} width="753" height="941" alt={w.alt} loading="lazy" decoding="async" draggable="false" />
              </picture>
              <div class="wf__cardfoot">
                <span class="label wf__cardname">{w.title}</span>
                <span class="label wf__cardn">{w.n}</span>
              </div>
              <span class="wf__frozen label">{w.frozen}</span>
            </li>
          ))}
        </ol>

        <div class="wf__controls">
          <button class="wf__btn" type="button" data-deck-prev aria-label="Previous workforce">
            <svg viewBox="0 0 24 12" width="24" height="12" aria-hidden="true" focusable="false"><path d="M24 6H1M7 1L1 6l6 5" fill="none" stroke="currentColor" stroke-width="1.2" /></svg>
          </button>
          <p class="label wf__hint">Drag a plate</p>
          <button class="wf__btn" type="button" data-deck-next aria-label="Next workforce">
            <svg viewBox="0 0 24 12" width="24" height="12" aria-hidden="true" focusable="false"><path d="M0 6h23M17 1l6 5-6 5" fill="none" stroke="currentColor" stroke-width="1.2" /></svg>
          </button>
        </div>
        <p class="sr-only" aria-live="polite" data-deck-live></p>
      </div>
    </div>
  </div>
</section>

<style>
  /* The ground takes a tint of the active world; the change is slow enough to feel like light, not a swap. */
  .wf {
    position: relative;
    display: grid; align-items: center;
    min-height: 100svh;
    padding-block: clamp(4rem, 10vh, 7rem);
    overflow: clip;
    background-color: var(--deck);
    /* Anchored off the right edge, behind the plate: light entering the room, not a shape floating in it. */
    background-image: radial-gradient(90% 110% at 102% 44%, color-mix(in oklab, var(--accent) 16%, transparent) 0%, transparent 66%);
    transition: background-image 900ms ease;
  }
  .wf__wrap { position: relative; z-index: 1; }

  .wf__head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--gutter); padding-block-end: 1rem; border-block-end: 1px solid var(--line); }
  .wf__count { color: var(--fg-soft); font-variant-numeric: tabular-nums; }
  .wf__count [data-deck-count] { color: var(--accent); transition: color 500ms ease; }
  .wf__of { margin-inline-start: 0.35em; }

  .wf__body { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: center; margin-block-start: clamp(2.5rem, 7vh, 5rem); }

  /* ── the readable half ── */
  .wf__panels { grid-column: 1 / 7; position: relative; min-height: clamp(21rem, 48vh, 30rem); }
  .wf__panel { position: absolute; inset-block-start: 0; inset-inline: 0; opacity: 0; visibility: hidden; transition: opacity 260ms linear, visibility 0s linear 260ms; }
  .wf__panel[data-on='true'] { opacity: 1; visibility: visible; transition: opacity 420ms ease-out 80ms, visibility 0s; }
  .wf__title { font-size: clamp(2.25rem, 4.6vw, 4.5rem); line-height: 0.95; }
  .wf__tl { display: block; }
  .wf__line { margin-block: 1.5rem 2rem; max-width: 26rem; color: var(--fg-soft); }
  .wf__roles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 var(--gutter); max-width: 30rem; }
  .wf__role { font-size: 0.75rem; line-height: 1.5; padding-block: 0.5rem; border-block-start: 1px solid var(--line-soft); color: var(--fg-soft); }
  .wf__cta { margin-block-start: 2rem; color: var(--fg); }

  /* Each panel arrives with its lines rising, so a change of card is felt, not just seen. */
  :global(html.motion) .wf__panel[data-on='true'] .wf__tl { animation: wf-rise 620ms var(--ease-freeze) backwards; }
  :global(html.motion) .wf__panel[data-on='true'] .wf__tl:nth-child(2) { animation-delay: 70ms; }
  @keyframes wf-rise { from { transform: translateY(0.5em); opacity: 0; } }

  /* ── the stack ── */
  .wf__deck { grid-column: 8 / 13; display: grid; justify-items: end; }
  /* Sized by height, not width: the plate and its controls always fit one screen. */
  .wf__stack { position: relative; height: clamp(19rem, 52vh, 36rem); aspect-ratio: 4 / 5; }
  .wf__stack:focus-visible { outline: 2px solid var(--accent); outline-offset: 14px; }
  .wf__card { position: relative; background: var(--studio); overflow: clip; }
  .wf__card img { width: 100%; height: 100%; object-fit: cover; user-select: none; }
  .wf__cardfoot { position: absolute; inset-inline: 0; inset-block-end: 0; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem 1.1rem; color: var(--bone); background: linear-gradient(0deg, rgba(11, 10, 9, 0.82) 0%, rgba(11, 10, 9, 0) 100%); }
  .wf__cardn { color: var(--accent); }
  .wf__frozen { position: absolute; inset-block-start: 1rem; inset-inline-start: 1.1rem; color: var(--bone-soft); }

  .wf__controls { display: flex; align-items: center; gap: 1.25rem; margin-block-start: 1.5rem; width: 100%; max-width: clamp(15.2rem, 41.6vh, 28.8rem); }
  .wf__btn { display: grid; place-items: center; width: 3rem; height: 3rem; border: 1px solid var(--line); border-radius: 50%; color: var(--fg-soft); transition: color var(--d-state) ease, border-color var(--d-state) ease, background-color var(--d-state) ease; }
  .wf__btn:hover, .wf__btn:focus-visible { color: var(--studio); background: var(--accent); border-color: var(--accent); }
  .wf__hint { flex: 1; text-align: center; color: var(--fg-soft); }

  /* ── live mode: the plates are stacked and thrown ── */
  [data-deck][data-live] .wf__card {
    position: absolute; inset: 0;
    transform-origin: 50% 140%; /* the pivot sits below the card, so it swings as if held at the bottom */
    will-change: transform;
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.9);
  }
  [data-deck][data-live] .wf__card[data-depth='0'] { cursor: grab; }
  [data-deck][data-live][data-dragging] .wf__card[data-depth='0'] { cursor: grabbing; }
  [data-deck][data-live] .wf__hint { opacity: 1; transition: opacity var(--d-state) ease; }
  [data-deck][data-live][data-dragging] .wf__hint { opacity: 0; }

  /* ── static fallback: an ordinary list ── */
  [data-deck]:not([data-live]) .wf__stack { aspect-ratio: auto; height: auto; display: grid; gap: var(--gutter); }
  [data-deck]:not([data-live]) .wf__controls, [data-deck]:not([data-live]) .wf__count { display: none; }
  [data-deck]:not([data-live]) .wf__panel { position: static; opacity: 1; visibility: visible; margin-block-end: var(--space-s); }
  [data-deck]:not([data-live]) .wf__panels { min-height: 0; }
  [data-deck]:not([data-live]) .wf__body { display: block; }

  @media (max-width: 1023px) {
    .wf__body { grid-template-columns: 1fr; row-gap: clamp(2rem, 5vh, 3.5rem); }
    .wf__panels { grid-column: 1; min-height: 22rem; order: 2; }
    .wf__deck { grid-column: 1; order: 1; justify-items: start; }
    .wf__stack { height: clamp(17rem, 42vh, 24rem); }
    .wf__btn { width: 3.25rem; height: 3.25rem; }
  }
  @media (max-width: 699px) {
    .wf__roles { grid-template-columns: 1fr; }
    .wf__panels { min-height: 24rem; }
    .wf__stack { height: min(58vh, 74vw); }
  }
</style>
