---
/**
 * Chapter V — how we work.
 *
 * The second sparse scene. Each commitment is a shouted line that arrives on its own scroll beat, with its
 * small print in mono beneath (Truck'N Roll: one sentence at 10 vw is a complete section). A new company has
 * no proof to show, so what it can offer is behaviour it will be held to — stated as large as a statistic
 * would have been.
 */
import { commitments } from '../../data/content';
---
<section class="hw surface ch-ink lit dots" id="how-we-work" data-theme="dark" data-chapter-name="How we work" aria-labelledby="hw-h" data-reveal>
  <div class="hw__wrap wrap">
    <header class="hw__head">
      <p class="label hw__label" data-rise style="--i:0">{commitments.label}</p>
      <h2 id="hw-h" class="hw__h display lines">
        {commitments.heading.map((l, i) => (
          <span class="l" style={`--i:${i}`}><span class={i ? 'recede' : ''}>{l}</span></span>
        ))}
      </h2>
      <p class="hw__intro lead" data-rise style="--i:3">{commitments.intro}</p>
    </header>

    <ol class="hw__list">
      {commitments.items.map((c, i) => (
        <li class="hw__item" data-reveal>
          <span class="label hw__n">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="hw__t lines"><span class="l" style="--i:0"><span>{c.title}</span></span></h3>
          <p class="hw__b mono" data-rise style="--i:1">{c.body}</p>
        </li>
      ))}
    </ol>

    <aside class="hw__donts" data-reveal>
      <p class="label hw__dl" data-rise style="--i:0">{commitments.dontLabel}</p>
      <ul class="hw__dlist">
        {commitments.donts.map((d, i) => <li class="hw__d mono" data-rise style={`--i:${i + 1}`}>{d}</li>)}
      </ul>
    </aside>
  </div>
</section>

<style>
  .hw {
    --light: radial-gradient(120% 60% at 50% 104%, rgba(194, 132, 86, 0.22) 0%, rgba(194, 132, 86, 0.04) 46%, rgba(194, 132, 86, 0) 74%);
    --dots-mask: linear-gradient(180deg, transparent 0%, #000 55%, transparent 100%);
    padding-block: clamp(6rem, 15vh, 11rem);
    overflow: clip;
  }
  .hw__wrap { position: relative; z-index: 1; }

  .hw__head { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: start; padding-block-end: clamp(2.5rem, 6vh, 4rem); }
  .hw__label { grid-column: 1 / 3; color: var(--fg-soft); padding-block-start: 0.55em; }
  .hw__h { grid-column: 3 / 9; font-size: clamp(2.5rem, 7vw, 7.5rem); line-height: 0.9; }
  .hw__intro { grid-column: 9 / 13; align-self: end; color: var(--fg-soft); font-size: var(--t-body); }

  .hw__list { border-block-start: 1px solid var(--line); }
  .hw__item {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 8fr) minmax(0, 4fr);
    column-gap: var(--gutter);
    align-items: baseline;
    padding-block: clamp(1.75rem, 4.5vh, 3rem);
    border-block-end: 1px solid var(--line);
  }
  .hw__n { color: var(--bronze); padding-block-start: 0.6em; }
  .hw__t {
    font-family: var(--f-display); font-weight: 400;
    font-size: clamp(1.75rem, 5.2vw, 5rem);
    line-height: 0.98; letter-spacing: -0.03em;
  }
  .hw__b { font-size: 0.8125rem; line-height: 1.6; color: var(--fg-soft); max-width: 24rem; }

  .hw__donts { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); margin-block-start: clamp(2.5rem, 6vh, 4rem); }
  .hw__dl { grid-column: 1 / 4; color: var(--fg-soft); }
  .hw__dlist { grid-column: 5 / 13; display: grid; gap: 0; }
  .hw__d { font-size: 0.75rem; line-height: 1.6; color: var(--fg-soft); padding-block: 0.7rem; border-block-start: 1px solid var(--line-soft); }
  .hw__d:last-child { border-block-end: 1px solid var(--line-soft); }

  @media (max-width: 1023px) {
    .hw__head { grid-template-columns: repeat(8, minmax(0, 1fr)); row-gap: 1.25rem; }
    .hw__label, .hw__h, .hw__intro { grid-column: 1 / 9; }
    .hw__item { grid-template-columns: 3rem minmax(0, 1fr); row-gap: 0.75rem; }
    .hw__b { grid-column: 2 / 3; }
    .hw__donts { grid-template-columns: 1fr; row-gap: 1rem; }
    .hw__dl, .hw__dlist { grid-column: 1; }
  }
  @media (max-width: 699px) {
    .hw__item { grid-template-columns: 2.5rem minmax(0, 1fr); }
    .hw__t { font-size: clamp(1.625rem, 8.5vw, 3rem); }
  }
</style>
