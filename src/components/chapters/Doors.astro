---
/**
 * Chapter VI — the two doors.
 *
 * The conversion moment, so it is given a scene rather than a text block. Each door holds the world it leads
 * to, graded almost to black and lit from the floor; approaching one brings the picture up — the door opens
 * onto what is behind it. Employers get the whole model, candidates get the scene where a document changes
 * hands. The pointer follower turns into a labelled arrow over each.
 *
 * The no-fee policy sits under the two as a plain statement of position, because for a candidate it is the
 * most important sentence on the site.
 */
import Arrow from '../ui/Arrow.astro';
import { doors, noFee } from '../../data/content';

const list = [
  { ...doors.employer, image: 'overview', focus: '50% 44%', n: '01' },
  { ...doors.candidate, image: 'recruitment', focus: '68% 50%', n: '02' },
];
const srcset = (id: string, fmt: string) => [800, 1200, 1672].map((w) => `/media/stills/${id}-${w}.${fmt} ${w}w`).join(', ');
---
<section class="dr surface ch-bronze" id="start" data-theme="dark" data-chapter-name="Start here" aria-labelledby="dr-h">
  <h2 id="dr-h" class="sr-only">Start with Nexora</h2>

  <div class="dr__panels">
    {list.map((d) => (
      <a class="dr__panel" href={d.href} data-cursor="label" data-cursor-label={d.cursor} data-reveal>
        <span class="dr__scene" aria-hidden="true">
          <picture>
            <source type="image/avif" srcset={srcset(d.image, 'avif')} sizes="(max-width: 899px) 100vw, 50vw" />
            <img src={`/media/stills/${d.image}-1200.webp`} srcset={srcset(d.image, 'webp')} sizes="(max-width: 899px) 100vw, 50vw" width="1672" height="941" alt="" loading="lazy" decoding="async" style={`object-position:${d.focus}`} />
          </picture>
        </span>

        <span class="dr__inner">
          <span class="dr__top">
            <span class="label dr__label" data-rise style="--i:0">{d.label}</span>
            <span class="label dr__n" data-rise style="--i:0">{d.n}</span>
          </span>

          <span class="dr__h lines">
            {d.heading.map((l, k) => <span class="l" style={`--i:${k}`}><span>{l}</span></span>)}
          </span>

          <span class="dr__b" data-rise style="--i:3">{d.body}</span>
          <span class="dr__cta label" data-rise style="--i:4">{d.cta}<Arrow /></span>
        </span>
      </a>
    ))}
  </div>

  <p class="dr__fee wrap">
    <strong class="dr__feeh">{noFee.heading}</strong>
    <span class="dr__feeb mono">{noFee.body}</span>
  </p>
</section>

<style>
  .dr { position: relative; background: var(--bronze-ground); overflow: clip; }

  .dr__panels { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .dr__panel {
    position: relative; isolation: isolate;
    display: flex; align-items: flex-end;
    min-height: clamp(28rem, 72vh, 46rem);
    padding: clamp(2.5rem, 7vh, 5rem) var(--margin);
    overflow: clip;
  }
  .dr__panel + .dr__panel { border-inline-start: 1px solid var(--line); }

  /* The world behind the door: nearly black at rest, brought up as you approach. */
  .dr__scene { position: absolute; inset: 0; z-index: -2; }
  .dr__scene img {
    width: 100%; height: 100%; object-fit: cover;
    filter: saturate(0.32) brightness(0.38) contrast(1.08);
    transform: scale(1.06);
    transition: filter 900ms var(--ease-io), transform 1400ms var(--ease-freeze);
  }
  .dr__panel:hover .dr__scene img, .dr__panel:focus-visible .dr__scene img {
    filter: saturate(0.85) brightness(0.62) contrast(1.02);
    transform: scale(1);
  }
  /* Enough veil that the copy is legible over the brightest state, laid over the picture. */
  .dr__panel::after {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      linear-gradient(0deg, rgba(12, 9, 6, 0.94) 0%, rgba(12, 9, 6, 0.6) 34%, rgba(12, 9, 6, 0.22) 68%, rgba(12, 9, 6, 0.42) 100%),
      radial-gradient(85% 60% at 50% 118%, rgba(194, 132, 86, 0.32) 0%, rgba(194, 132, 86, 0) 68%);
    transition: opacity 700ms ease;
  }
  .dr__panel:hover::after, .dr__panel:focus-visible::after { opacity: 0.92; }

  .dr__inner { display: block; width: 100%; max-width: 26rem; }
  .dr__top { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding-block-end: 0.85rem; margin-block-end: clamp(1.5rem, 5vh, 3rem); border-block-end: 1px solid var(--line); }
  .dr__label { color: var(--fg-soft); }
  .dr__n { color: var(--bronze); }
  .dr__h { display: block; font-family: var(--f-display); font-size: clamp(2.5rem, 5.6vw, 5.5rem); line-height: 0.94; letter-spacing: -0.03em; }
  .dr__b { display: block; margin-block: 1.5rem 2rem; color: var(--fg-soft); font-size: var(--t-small); line-height: 1.55; max-width: 22rem; }
  .dr__cta { display: inline-flex; align-items: center; gap: 0.75em; padding-block: 0.35em; position: relative; }
  .dr__cta::after { content: ''; position: absolute; inset-inline: 0; bottom: 0; height: 1px; background: currentColor; opacity: 0.35; }
  .dr__cta::before { content: ''; position: absolute; inset-inline: 0; bottom: 0; height: 1px; background: var(--bronze); transform: scaleX(0); transform-origin: left; transition: transform var(--d-reveal) var(--ease-freeze); z-index: 1; }
  .dr__panel:hover .dr__cta::before, .dr__panel:focus-visible .dr__cta::before { transform: scaleX(1); }

  .dr__fee {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: 0.75rem;
    padding-block: clamp(2rem, 5vh, 3.5rem);
    border-block-start: 1px solid var(--line);
  }
  .dr__feeh { grid-column: 1 / 6; font-family: var(--f-display); font-weight: 400; font-size: clamp(1.25rem, 2.2vw, 2rem); line-height: 1.1; letter-spacing: -0.02em; }
  .dr__feeb { grid-column: 6 / 12; font-size: 0.75rem; line-height: 1.6; color: var(--fg-soft); }

  @media (max-width: 899px) {
    .dr__panels { grid-template-columns: 1fr; }
    .dr__panel + .dr__panel { border-inline-start: 0; border-block-start: 1px solid var(--line); }
    .dr__panel { min-height: clamp(22rem, 56vh, 30rem); }
    .dr__inner { max-width: none; }
    .dr__fee { grid-template-columns: 1fr; }
    .dr__feeh, .dr__feeb { grid-column: 1; }
  }

  /* Without motion the picture simply sits at its readable state. */
  :global(html:not(.motion)) .dr__scene img { filter: saturate(0.6) brightness(0.5); transform: none; }
</style>
