---
/**
 * Chapter I — what Nexora is.
 *
 * Ember ground, lit from the left. The statement is a monument in the first five columns; the registry sits
 * beside it as a hairline table of facts that are true today (Kononenko's credentials table, White Desert's
 * "specifics instead of statistics"). Cells are deliberately left empty — that is the breathing (Aspen).
 */
import { manifesto, statement } from '../../data/content';
import { site } from '../../data/site';

const srcset = (id: string, fmt: string) => [800, 1200, 1672].map((w) => `/media/stills/${id}-${w}.${fmt} ${w}w`).join(', ');
---
<section class="mf surface ch-ember lit grain" id="statement" data-theme="dark" data-chapter-name="Who we are" aria-labelledby="mf-h" data-reveal>
  <div class="mf__wrap wrap">
    <div class="mf__grid">
      <p class="label mf__label" data-rise style="--i:0">{manifesto.label}</p>

      <h2 id="mf-h" class="mf__lines lines">
        {manifesto.lines.map((line, i) => (
          <span class="l" style={`--i:${i}`}><span class={i === manifesto.lines.length - 1 ? 'recede' : ''}>{line}</span></span>
        ))}
      </h2>

      <p class="mf__body lead" data-rise style="--i:4">{manifesto.body}</p>

      <dl class="mf__registry" data-rise style="--i:5">
        {statement.facts.map((f) => (
          <div class="mf__row">
            <dt class="label label--soft">{f.k}</dt>
            <dd class="mono mf__val">{f.v}</dd>
          </div>
        ))}
        <div class="mf__row">
          <dt class="label label--soft">Legal name</dt>
          <dd class="mono mf__val">{site.legalName}</dd>
        </div>
      </dl>

      <figure class="mf__plate" data-rise style="--i:6">
        <picture>
          <source type="image/avif" srcset={srcset('overview', 'avif')} sizes="(max-width: 699px) 92vw, 34vw" />
          <img src="/media/stills/overview-800.webp" srcset={srcset('overview', 'webp')} sizes="(max-width: 699px) 92vw, 34vw" width="1672" height="941" alt={manifesto.detail.caption} loading="lazy" decoding="async" />
        </picture>
        <figcaption class="label label--soft">{manifesto.detail.caption}</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .mf {
    --light: radial-gradient(90% 80% at 2% 32%, rgba(194, 132, 86, 0.2) 0%, rgba(194, 132, 86, 0.05) 38%, rgba(194, 132, 86, 0) 70%);
    padding-block: clamp(6rem, 14vh, 11rem) clamp(5rem, 12vh, 9rem);
    overflow: clip;
  }
  .mf__wrap { position: relative; z-index: 1; }

  /* 12 columns with the hairlines visible. Empty cells do the breathing. */
  .mf__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    align-items: start;
  }

  .mf__label { grid-column: 1 / 3; padding-block-end: 1rem; border-block-start: 1px solid var(--line); padding-block-start: 0.9rem; }

  .mf__lines {
    grid-column: 1 / 9; grid-row: 2;
    font-family: var(--f-display); font-weight: 400;
    font-size: clamp(2.75rem, 8.4vw, 9.5rem);
    line-height: 0.88; letter-spacing: -0.035em;
    margin-block: clamp(1.5rem, 4vh, 3rem) 0;
  }

  .mf__body { grid-column: 1 / 5; grid-row: 3; margin-block-start: clamp(2.5rem, 6vh, 4.5rem); color: var(--fg-soft); }

  .mf__registry { grid-column: 9 / 13; grid-row: 2 / 4; margin-block-start: clamp(1.5rem, 4vh, 3rem); }
  .mf__row { display: grid; grid-template-columns: minmax(6rem, 5fr) 8fr; gap: var(--gutter); align-items: baseline; padding-block: 0.85rem; border-block-start: 1px solid var(--line); }
  .mf__row:last-child { border-block-end: 1px solid var(--line); }
  .mf__val { font-size: 0.8125rem; line-height: 1.45; }

  .mf__plate { grid-column: 9 / 13; grid-row: 4; margin-block-start: clamp(2.5rem, 6vh, 4.5rem); }
  .mf__plate img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; object-position: 50% 42%; }
  .mf__plate figcaption { margin-block-start: 0.85rem; padding-block-start: 0.85rem; border-block-start: 1px solid var(--line); }

  @media (max-width: 1023px) {
    .mf__grid { grid-template-columns: repeat(8, minmax(0, 1fr)); }
    .mf__label { grid-column: 1 / 4; }
    .mf__lines { grid-column: 1 / 9; font-size: clamp(2.75rem, 9.5vw, 6rem); }
    .mf__body { grid-column: 1 / 6; grid-row: 3; }
    .mf__registry { grid-column: 1 / 9; grid-row: 4; margin-block-start: clamp(2.5rem, 6vh, 4rem); }
    .mf__plate { grid-column: 1 / 9; grid-row: 5; }
    .mf__plate img { aspect-ratio: 16 / 9; }
  }
  @media (max-width: 699px) {
    .mf__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .mf__label, .mf__lines, .mf__body, .mf__registry, .mf__plate { grid-column: 1 / 5; }
    .mf__lines { font-size: clamp(2.5rem, 13vw, 4.5rem); }
    .mf__row { grid-template-columns: 1fr; gap: 0.3rem; }
  }
</style>
