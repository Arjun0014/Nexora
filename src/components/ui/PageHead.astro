---
/**
 * The opening of a subpage, on the homepage's day grounds: sky, clouds, a centred title in the display capitals
 * (a word wrapped in *asterisks* becomes the italic accent), the lead, and the page's checkable facts in one
 * hairline row. Below it a photograph in an ARCH that opens to full bleed as it scrolls up (ERA's window,
 * src/scripts/pagehead.ts). Without motion the photograph is simply full width.
 */
import type { WorldId } from '../../data/worlds';
import { stock, type Photo } from '../../data/stock';

interface Props {
  label: string;
  title: string[];
  lead?: string;
  theme?: 'dark' | 'paper';
  /** A workforce (its photograph) or 'overview' (the Doha skyline). Superseded by `photo`. */
  plate?: WorldId | 'overview';
  photo?: Photo;
  plateCaption?: string;
  meta?: { k: string; v: string }[];
  id?: string;
}
const { label, title, lead, plate, photo, plateCaption, meta = [], id = 'page-h' } = Astro.props;
const img: Photo | undefined = photo ?? (plate ? (plate === 'overview' ? stock.doha.skyline : stock.workforces[plate]) : undefined);
const parts = (line: string) => line.split(/(\*[^*]+\*)/).filter(Boolean).map((p) => (p.startsWith('*') ? { em: true, t: p.slice(1, -1) } : { em: false, t: p }));
---
<section class="ph" data-bg="light" aria-labelledby={id}>
  <img class="ph__cloud ph__cloud--l" src="/media/clouds/px-cloud-01.webp" alt="" aria-hidden="true" decoding="async" data-ph-cloud="-14" />
  <img class="ph__cloud ph__cloud--r" src="/media/clouds/px-cloud-05.webp" alt="" aria-hidden="true" decoding="async" data-ph-cloud="-26" />

  <div class="ph__inner">
    <p class="label ph__label">{label}</p>
    <h1 id={id} class="display ph__title">
      {title.map((line) => <span class="ph__line">{parts(line).map((p) => (p.em ? <em>{p.t}</em> : p.t))}</span>)}
    </h1>
    {lead && <p class="ph__lead">{lead}</p>}
    {meta.length > 0 && (
      <dl class="ph__meta">
        {meta.map((m) => (
          <div class="ph__row"><dt class="label">{m.k}</dt><dd>{m.v}</dd></div>
        ))}
      </dl>
    )}
    <div class="ph__slot"><slot /></div>
  </div>

  {img && (
    <figure class="ph__plate" data-ph-plate>
      <img src={img.src} srcset={img.srcset} sizes="100vw" width="2400" height="1600" alt={img.alt} fetchpriority="high" decoding="async" style={`object-position:${img.focus}`} />
      {plateCaption && <figcaption class="label ph__cap">{plateCaption}</figcaption>}
    </figure>
  )}
</section>

<style>
  .ph { --bg: var(--sky); position: relative; overflow: clip; background: var(--bg); color: var(--ink); padding-block-start: calc(var(--header-h) + clamp(3rem, 11vh, 8rem)); }
  .ph__inner { position: relative; z-index: 1; display: grid; justify-items: center; text-align: center; gap: clamp(1.25rem, 3vh, 2rem); padding: 0 var(--margin) clamp(3rem, 9vh, 6rem); }
  .ph__label { opacity: 0.75; }
  .ph__title { font-size: clamp(3.2rem, 8.6vw, 10.5rem); line-height: 0.86; }
  .ph__line { display: block; }
  .ph__lead { max-width: 34rem; font-size: var(--t-lead); line-height: 1.5; color: var(--ink-soft); }
  .ph__meta { display: flex; flex-wrap: wrap; justify-content: center; gap: 0 2.5rem; margin-block-start: 0.5rem; padding-block: 1rem; border-block: 1px solid var(--line); max-width: 64rem; }
  .ph__row { display: flex; gap: 0.8rem; align-items: baseline; padding-block: 0.3rem; font-size: var(--t-small); }
  .ph__row dt { opacity: 0.7; }
  .ph__slot { width: 100%; }
  .ph__slot:empty { display: none; }

  .ph__cloud { position: absolute; pointer-events: none; will-change: transform; opacity: 0.85; }
  .ph__cloud--l { width: min(44vw, 720px); left: -14vw; top: 14vh; }
  .ph__cloud--r { width: min(38vw, 620px); right: -10vw; top: 38vh; }

  .ph__plate { position: relative; margin: 0; height: clamp(22rem, 78vh, 54rem); overflow: hidden; }
  .ph__plate img { width: 100%; height: 100%; object-fit: cover; }
  :global(html.motion) .ph__plate { --o: 0; clip-path: inset(0 calc(32vw * (1 - var(--o))) 0 calc(32vw * (1 - var(--o))) round calc(18vw * (1 - var(--o))) calc(18vw * (1 - var(--o))) 0 0); }
  :global(html.motion) .ph__plate img { transform: scale(calc(1.12 - 0.12 * var(--o))); }
  .ph__cap { position: absolute; left: var(--margin); bottom: 1.25rem; color: var(--bone); text-shadow: 0 1px 12px rgba(0, 0, 0, 0.5); }

  @media (max-width: 767px) {
    :global(html.motion) .ph__plate { clip-path: inset(0 calc(14vw * (1 - var(--o))) 0 calc(14vw * (1 - var(--o))) round calc(36vw * (1 - var(--o))) calc(36vw * (1 - var(--o))) 0 0); }
    .ph__meta { gap: 0 1.2rem; }
  }
</style>
