---
/**
 * The film, version 9: the turning world — a limestone court under a latticed dome that turns about its pool, five
 * tall doorways onto five films of work, always playing. See docs/redesign/09-HERO-V9.md (07 for the turn).
 *
 * DEFAULT (no JS, reduced motion, Save-Data): six ordinary sections on limestone — the overview, the five worlds each
 * in an arch (its film's poster, in the doorway's own 9:16 shape; nothing plays), the title card — complete and
 * readable.
 *
 * html.cinema (set pre-paint): the same markup becomes ONE screen-high stage; the chapters stack over a WebGPU canvas
 * that draws the court (src/scripts/hero/court), stepped by gesture. Words only ever stand on plain stone in shade:
 * the first screen's title on the floor before the pool (one line, fitted to the page's margins, over the ring of
 * names), each world's words on the wall beside its doorway, on the doorway's foot (--door-left/right/top/bottom,
 * published by the canvas). The ring of names is the court unrolled: its mark follows the doorway you face.
 */
import Arrow from '../ui/Arrow.astro';
import { worlds, overview } from '../../data/worlds';
import { statement } from '../../data/content';
import { site } from '../../data/site';
const img = (id: string) => `/media/hero9/${id}-poster-720.webp`;
const srcset = (id: string) => `/media/hero9/${id}-poster-720.webp 720w, /media/hero9/${id}-poster-1080.webp 1080w`;
---
<section class="hero" id="film" data-hero data-header-clear data-theme="paper" data-bg="light" aria-label="Introduction">
  <div class="hero__stage" data-stage>
    <div class="hero__media" data-media>
      <!-- The film: the court, drawn live by src/scripts/hero/court. -->
      <canvas class="hero__canvas" data-canvas role="img" aria-label={overview.alt}></canvas>
    </div>
    <canvas class="hero__mask" data-mask aria-hidden="true"></canvas>

    <div class="hero__ui">
      <section class="ch ch--overview" data-chapter="overview" data-active="true" aria-labelledby="hero-h1">
        <figure class="ch__frame ch__frame--court" aria-hidden="true">
          <img src="/media/hero6/court-960.webp" srcset="/media/hero6/court-960.webp 960w, /media/hero6/court-1600.webp 1600w" sizes="(max-aspect-ratio: 1/1) 90vw, 50vw" width="1600" height="1000" alt="" loading="lazy" decoding="async" />
        </figure>
        <div class="ch__copy">
          <p class="label ch__label">{overview.label}</p>
          <h1 id="hero-h1" class="ch__h1 lines" data-fit>
            {overview.headline.map((line, i) => <><span class="l" style={`--i:${i}`}><span>{line.startsWith('many ') ? <><em>many</em>{line.slice(4)}</> : line}</span></span>{i === 0 ? ' ' : ''}</>)}
          </h1>
          <p class="ch__support" style="--i:2">{overview.support}</p>
        </div>
      </section>

      {worlds.map((w) => (
        <section class="ch ch--world" data-chapter={w.id} data-sector={w.id} aria-labelledby={`world-${w.id}`}>
          <figure class="ch__frame ch__frame--film">
            <img src={img(w.id)} srcset={srcset(w.id)} sizes="(max-aspect-ratio: 1/1) 60vw, 26vw" width="1080" height="1920" alt={w.moment} loading="lazy" decoding="async" />
          </figure>
          <div class="ch__copy">
            <p class="label ch__label"><span class="num">{w.n}</span><span class="ch__rule" aria-hidden="true"></span><span class="ch__of">05</span></p>
            <h2 id={`world-${w.id}`} class="display ch__title lines">
              {w.titleLines.map((line, i) => <span class="l" style={`--i:${i}`}><span>{line}</span></span>)}
            </h2>
            <p class="ch__line" style={`--i:${w.titleLines.length}`}>{w.line}</p>
            <a class="tlink label ch__link" href={`/services/#${w.id}`} style={`--i:${w.titleLines.length + 1}`} data-hero-link>{w.linkLabel}<Arrow /></a>
          </div>
        </section>
      ))}

      <section class="ch ch--title" data-chapter="title" aria-labelledby="title-h">
        <h2 id="title-h" class="sr-only">Nexora</h2>
        <!-- Static fallback for the title card: a moment shows through the word via a CSS mask. -->
        <div class="ch__word" aria-hidden="true"></div>
        <p class="h1 ch__statement lines" data-title-line>
          <span class="l" style="--i:0"><span>{statement.heading[0]}</span></span>
          <span class="l" style="--i:1"><span><em>{statement.heading[1]}</em></span></span>
        </p>
        <div class="ch__meta label" style="--i:3">
          <span>{site.legalName}</span>
          <span>Est. {site.established} — {site.city}, {site.country}</span>
        </div>
      </section>

      <!-- The ring, unrolled: the five doorways in the order they stand round the court. Its mark is where the court
           faces you (it slides as the court turns, and along the tour); each name takes you to that doorway. -->
      <nav class="ring" data-ring aria-label="The five workforces">
        <ol class="ring__list">
          {worlds.map((w, i) => (
            <li><button type="button" class="ring__item" data-ring-item={i} aria-label={`${w.title}: go to this doorway`}><span class="ring__n">{w.n}</span><span class="ring__name">{w.short}</span></button></li>
          ))}
        </ol>
        <span class="ring__rule" aria-hidden="true"><i class="ring__mark" data-ring-mark></i><i class="ring__mark" data-ring-mark></i></span>
      </nav>
    </div>
  </div>
</section>

<style>
  /* ═══ DEFAULT: six ordinary sections on limestone ═══════════════════════════════════════ */
  .hero { position: relative; background: var(--sand); color: var(--ink); }
  .hero__media, .hero__mask { display: none; }

  .ch {
    position: relative; display: grid; align-items: end;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr); gap: clamp(2rem, 5vw, 6rem);
    min-height: 100vh; min-height: 100svh;
    padding: calc(var(--header-h) + 2rem) var(--margin) clamp(2.5rem, 7vh, 5rem);
  }
  .ch + .ch { border-block-start: 1px solid var(--line-soft); }
  .ch__frame { grid-column: 2; grid-row: 1; align-self: stretch; margin: 0; overflow: hidden; border-radius: 999px 999px 0 0 / 50% 50% 0 0; max-height: 82vh; }
  .ch__frame--court { border-radius: 999px 999px 0 0 / 60% 60% 0 0; aspect-ratio: 16 / 11; align-self: center; max-height: none; }
  .ch__frame--court img { object-position: 50% 60%; }
  .ch__frame img { width: 100%; height: 100%; object-fit: cover; }
  /* the worlds: each film's poster in its doorway's own shape (9:16, the arch rising 0.55 of its width) */
  .ch__frame--film { justify-self: center; align-self: end; height: min(78vh, 52rem); max-height: none; aspect-ratio: 9 / 16; border-radius: 50% 50% 0 0 / 31% 31% 0 0; }
  .ch__copy { grid-column: 1; grid-row: 1; max-width: 34rem; }

  .ch__label { display: flex; align-items: center; gap: 0.9em; margin-block-end: 1.4rem; color: var(--ink-soft); }
  .ch__rule { width: 2.25rem; height: 1px; background: currentColor; opacity: 0.5; }
  .ch__h1 { font-family: var(--f-display); font-stretch: 62.5%; font-weight: 300; text-transform: uppercase; font-size: clamp(3rem, 5.6vw, 7.2rem); line-height: 0.88; letter-spacing: -0.006em; }
  .ch__h1 .l > span { white-space: nowrap; }
  .ch__h1 em { font-style: italic; font-stretch: 75%; text-transform: none; color: var(--amber-deep); }
  .ch__support { margin-block-start: 1.5rem; max-width: 25rem; font-size: var(--t-body); line-height: 1.55; color: var(--ink-soft); }
  .ch__title { font-size: clamp(2.75rem, 5.4vw, 6.8rem); line-height: 0.9; }
  .ch__title .l > span { white-space: nowrap; }
  .ch__line { margin-block: 1.5rem 1.75rem; max-width: 26rem; font-size: var(--t-lead); line-height: 1.45; }
  .ch__link { color: var(--ink); }

  .ch--title { display: flex; flex-direction: column; align-items: stretch; justify-content: center; gap: clamp(2rem, 5vw, 4rem); min-height: 80svh; background: var(--studio); color: var(--bone); }
  .ch__word { width: 100%; aspect-ratio: 4290 / 740; background: url('/media/hero9/facilities-poster-1080.webp') 50% 60% / cover no-repeat var(--bone);
    -webkit-mask: url('/wordmark.svg') center / contain no-repeat; mask: url('/wordmark.svg') center / contain no-repeat; }
  .ch__statement em { color: var(--amber); }
  .ch__meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 2rem; color: var(--bone-soft); padding-block-start: 1.25rem; border-block-start: 1px solid rgba(243, 237, 227, 0.16); }

  /* ═══ CINEMA: one screen, stepped by gesture ═══════════════════════════════════════════ */
  :global(html.cinema) .hero { height: 100vh; height: 100svh; }
  :global(html.cinema) .hero__stage { position: relative; height: 100%; overflow: clip; background: #e9e1d5; contain: layout paint; }
  :global(html.cinema) .hero__media { display: block; position: absolute; inset: 0; transform-origin: 50% 50%; will-change: transform; }
  .hero__canvas, .hero__mask { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero__canvas { display: block; touch-action: pan-y; }
  :global(html.cinema) .hero:not([data-ready]) .hero__media { opacity: 0; }
  :global(html.cinema) .hero[data-ready] .hero__media { opacity: 1; transition: opacity 600ms ease-out; }
  :global(html.cinema) .hero__mask { display: block; z-index: 3; pointer-events: none; }
  /* a breath of limestone behind the header, so its small type reads over the lattice; gone on the black card */
  :global(html.cinema) .hero__stage::before {
    content: ''; position: absolute; inset: 0 0 auto; height: calc(var(--header-h) + 4.5rem); z-index: 4; pointer-events: none;
    background: linear-gradient(rgba(236, 228, 216, 0.82), rgba(236, 228, 216, 0.5) 45%, rgba(236, 228, 216, 0));
    transition: opacity 500ms ease;
  }
  :global(html.cinema) .hero[data-bg='dark'] .hero__stage::before { opacity: 0; }

  :global(html.cinema) .hero__ui { position: absolute; inset: 0; z-index: 5; pointer-events: none; }
  :global(html.cinema) .ch { display: block; position: absolute; inset: 0; min-height: 0; padding: 0; border: 0; pointer-events: none; background: none; }
  :global(html.cinema) .ch__frame { display: none; }
  :global(html.cinema) .ch[data-active='true'] .ch__copy { pointer-events: auto; }

  /* Every world's words stand on its doorway's foot (one ground line for the door and the words), on the wall beside
     it: at every stop the sun is behind that wall, so the words sit on plain stone in soft shade — nothing behind
     them but limestone. */
  :global(html.cinema) .ch__copy {
    position: absolute; inset-inline-start: var(--margin);
    inset-block-end: calc(100% - var(--door-bottom, 92%) + 0.2rem);
    width: calc(var(--door-left, 48vw) - var(--margin) * 2.2); max-width: 31rem;
  }
  /* The first screen: the title stands on the court's floor, in the shade before the pool, while the court turns
     above it. One line, fitted to the page's margins (--fit-size, --fit-w: ./ui.ts), over the ring of names. */
  :global(html.cinema) .hero { --ring-b: clamp(1.5rem, 4.6vh, 2.9rem); --ring-h: 2.35rem; --ring-gap: clamp(1.1rem, 2.8vh, 1.9rem); }
  :global(html.cinema) .ch--overview .ch__copy {
    inset-inline: 0; margin-inline: auto; width: var(--fit-w, 88vw); max-width: none; text-align: center;
    inset-block-end: calc(var(--ring-b) + var(--ring-h) + var(--ring-gap));
  }
  :global(html.cinema) .ch--overview .ch__h1 { white-space: nowrap; width: max-content; margin-inline: auto; font-size: var(--fit-size, 6.6vw); line-height: 0.84; }
  :global(html.cinema) .ch--overview .ch__h1 .l { display: inline-block; }
  :global(html.cinema) .ch--overview .ch__h1 em { color: inherit; }
  :global(html.cinema) .ch--overview .ch__label, :global(html.cinema) .ch--overview .ch__support {
    position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap;
  }

  /* The ring of names (cinema only): the width of the title, on a hairline whose mark rides under the name you face. */
  .ring { display: none; }
  :global(html.cinema) .ring {
    display: block; position: absolute; inset-inline: 0; margin-inline: auto; width: var(--fit-w, 88vw);
    inset-block-end: var(--ring-b); pointer-events: auto; transition: opacity 500ms ease, visibility 0s linear 0s;
  }
  :global(html.cinema) .hero:not([data-ring]) .ring { opacity: 0; visibility: hidden; pointer-events: none; transition: opacity 300ms ease, visibility 0s linear 300ms; }
  .ring__rule { position: relative; display: block; height: 1px; background: rgba(28, 27, 46, 0.3); clip-path: inset(-4px 0); }
  .ring__mark { position: absolute; inset-block-start: -1px; inset-inline-start: 0; height: 3px; width: var(--w, 3rem); background: var(--ink); transform: translateX(var(--x, 0)); opacity: var(--o, 0); }
  .ring__list { display: flex; justify-content: space-between; margin: 0; padding: 0; list-style: none; }
  .ring__list > li { display: flex; }
  .ring__item {
    display: inline-flex; gap: 0.85em; padding: 0.35rem 0 0.9rem; border: 0; background: none; cursor: pointer; color: rgba(28, 27, 46, 0.68);
    font-family: var(--f-label); font-stretch: 125%; font-size: var(--t-label); line-height: 1; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase;
    transition: color 400ms ease;
  }
  .ring__n { font-variant-numeric: tabular-nums; }
  .ring__item[data-on], .ring__item:hover, .ring__item:focus-visible { color: var(--ink); }
  .ring__item:focus-visible { outline: 1px solid currentColor; outline-offset: 4px; }

  /* Copy leaves the instant time resumes; arrives as the window opens and settles. */
  :global(html.cinema) .ch .ch__copy { opacity: 0; transition: opacity 0s linear 300ms; }
  :global(html.cinema) .ch[data-active='true'] .ch__copy { opacity: 1; transition-delay: 0s; }
  :global(html.cinema) .ch .l > span { transform: translateY(118%); transition: transform 280ms cubic-bezier(0.5, 0, 0.9, 0.4); }
  :global(html.cinema) .ch .ch__label, :global(html.cinema) .ch .ch__support, :global(html.cinema) .ch .ch__line, :global(html.cinema) .ch .ch__link { opacity: 0; transform: translateY(12px); transition: opacity 220ms ease, transform 220ms ease; }
  :global(html.cinema) .ch[data-active='true'] .l > span { transform: none; transition: transform var(--d-type) var(--ease-freeze); transition-delay: calc(var(--i, 0) * 90ms + 80ms); }
  :global(html.cinema) .ch[data-active='true'] .ch__label, :global(html.cinema) .ch[data-active='true'] .ch__support, :global(html.cinema) .ch[data-active='true'] .ch__line, :global(html.cinema) .ch[data-active='true'] .ch__link { opacity: 1; transform: none; transition: opacity 600ms ease-out, transform 700ms var(--ease-freeze); transition-delay: calc(var(--i, 0) * 90ms + 160ms); }

  /* The title card: the black of the NEXORA knock-out, light type (unchanged from v4). */
  :global(html.cinema) .ch--title { display: block; padding: 0; min-height: 0; background: none; color: var(--bone); }
  :global(html.cinema) .ch--title .ch__statement { opacity: 0; transition: opacity 0s linear 280ms; }
  :global(html.cinema) .ch--title[data-active='true'] .ch__statement { opacity: 1; transition-delay: 0s; }
  :global(html.cinema) .ch__word { display: none; }
  :global(html.cinema) .ch__statement { position: absolute; inset-inline: 6vw; inset-block-start: var(--title-y, 62%); max-width: 16em; }
  :global(html.cinema) .ch__meta { position: absolute; inset-inline: 6vw; inset-block-end: clamp(1.5rem, 5vh, 3.25rem); opacity: 0; transition: opacity 200ms ease; }
  :global(html.cinema) .ch[data-active='true'] .ch__meta { opacity: 1; transition: opacity 700ms ease-out 500ms; }

  /* ═══ UPRIGHT SCREENS ══════════════════════════════════════════════════════════════════
     The window stands at the top; the words stand under it, on its foot. In the film the doorway stands squarely
     across the top of the screen and the words on the floor below it — floor the light is kept off, so it is as
     plain a ground as the wall is on a wide screen (court/index.ts, UP). */
  @media (max-aspect-ratio: 104/100) {
    .ch { grid-template-columns: 1fr; align-content: end; gap: 2rem; }
    .ch__frame, .ch__copy { grid-column: 1; }
    .ch__frame { grid-row: 1; max-height: 52vh; aspect-ratio: 4 / 5; }
    .ch__frame--court { aspect-ratio: 4 / 3; width: 100%; justify-self: center; }
    .ch__frame--film { height: min(58vh, 40rem); max-height: none; aspect-ratio: 9 / 16; justify-self: center; }
    .ch__copy { grid-row: 2; }
    .ch__h1 { font-size: clamp(2.6rem, 12.4vw, 4.6rem); }
    .ch__title { font-size: clamp(2.5rem, 11.8vw, 4.4rem); }
    .ch__line { font-size: 1.0625rem; margin-block: 1rem 1.25rem; }
    .ch__support { margin-block-start: 1rem; }
    .ch__link { display: flex; justify-content: space-between; padding-block: 0.9rem; border-block-start: 1px solid var(--line); }
    .ch__link::after, .ch__link::before { display: none; }

    :global(html.cinema) .ch__copy { inset-block: calc(var(--door-bottom, 58%) + clamp(1rem, 2.6vh, 1.75rem)) auto; inset-inline: var(--margin); width: auto; max-width: none; }
    :global(html.cinema) .ch--world .ch__copy { max-width: none; }
    :global(html.cinema) .ch__statement { inset-inline: var(--margin); font-size: clamp(2rem, 9vw, 3rem); }

    /* The first screen: the title on the floor before the pool, two lines fitted to the margins, over the ring. */
    :global(html.cinema) .ch--overview .ch__copy {
      inset-block: auto calc(var(--ring-b) + var(--ring-h) + var(--ring-gap)); inset-inline: var(--margin);
      width: auto; text-align: start;
    }
    :global(html.cinema) .ch--overview .ch__h1 { white-space: normal; width: auto; margin-inline: 0; line-height: 0.86; }
    :global(html.cinema) .ch--overview .ch__h1 .l { display: block; }

    /* The ring, upright: no room for five names, so the five doorways are numbered and the mark rides under the one
       you face. The name is said by the words themselves at each stop (and by each button, to a screen reader). */
    :global(html.cinema) .hero { --ring-h: 1.5rem; --ring-gap: clamp(0.9rem, 2.4vh, 1.5rem); }
    :global(html.cinema) .ring { inset-inline: var(--margin); width: auto; }
    .ring__name { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .ring__item { gap: 0; padding: 0.25rem 0.5rem 0.65rem; margin-inline: -0.5rem; letter-spacing: 0.1em; }
  }
  /* Short upright phones (SE and the like): the window has taken its share, the words tighten to fit under it. */
  @media (max-aspect-ratio: 104/100) and (max-height: 720px) {
    :global(html.cinema) .ch__copy { inset-block-start: calc(var(--door-bottom, 58%) + 0.7rem); }
    .ch__label { margin-block-end: 0.8rem; }
    .ch__h1 { font-size: clamp(2.3rem, 10.6vw, 3.4rem); }
    .ch__title { font-size: clamp(2.2rem, 10.2vw, 3.3rem); }
    .ch__line { font-size: 0.975rem; margin-block: 0.7rem 0.6rem; }
    .ch__link { padding-block: 0.7rem; }
    :global(html.cinema) .ch--overview .ch__support { display: none; }
  }
  /* The shortest phones (SE and the like): the words tighten again, so the ring keeps its place under them. */
  @media (max-aspect-ratio: 104/100) and (max-height: 620px) {
    .ch__line { font-size: 0.9375rem; margin-block: 0.55rem 0.5rem; }
    .ch__link { padding-block: 0.55rem; }
    .ch__label { margin-block-end: 0.6rem; }
  }
  /* Phones on their side: little height, so the type floor drops. */
  @media (max-height: 520px) and (min-aspect-ratio: 1/1) {
    .ch__title { font-size: clamp(2rem, 5.2vw, 3.25rem); }
    .ch__h1 { font-size: clamp(2.2rem, 6vw, 3.6rem); }
    .ch__label { margin-block-end: 0.75rem; }
    .ch__line { font-size: 1rem; margin-block: 0.75rem 1rem; }
    .ch__support { display: none; }
  }
</style>
