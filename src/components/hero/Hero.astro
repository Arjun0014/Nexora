---
/**
 * The film.
 *
 * DEFAULT (no JS, reduced motion, Save-Data): six ordinary full-height sections — overview, five worlds,
 * title card — each with the approved high-res still behind its copy. Complete and readable.
 *
 * html.cinema (set pre-paint): the same markup becomes ONE screen-high stage; the chapters stack; a WebGL canvas
 * draws the five moments live; src/scripts/hero steps it by gesture. See docs/redesign/04-HERO-V4.md.
 * There is deliberately no HUD: no skip, pause, timecode, glyph, world selector or scroll hint.
 */
import Arrow from '../ui/Arrow.astro';
import { worlds, overview } from '../../data/worlds';
import { statement } from '../../data/content';
import { site } from '../../data/site';
const sizes = '100vw';
const srcset = (id: string, fmt: string) => [800, 1200, 1672].map((w) => `/media/stills/${id}-${w}.${fmt} ${w}w`).join(', ');
---
<section class="hero" id="film" data-hero data-header-clear data-theme="dark" aria-label="Introduction">
  <div class="hero__stage" data-stage>
    <div class="hero__media" data-media>
      <!-- The film: a real-time 3D scene drawn by src/scripts/hero/world. -->
      <canvas class="hero__canvas" data-canvas role="img" aria-label={overview.alt}></canvas>
    </div>
    <div class="hero__scrim" data-scrim aria-hidden="true"></div>
    <canvas class="hero__mask" data-mask aria-hidden="true"></canvas>

    <div class="hero__ui">
      <section class="ch ch--overview" data-chapter="overview" data-active="true" aria-labelledby="hero-h1">
        <picture class="ch__bg">
          <source type="image/avif" srcset={srcset('overview', 'avif')} sizes={sizes} />
          <img src="/media/stills/overview-1200.webp" srcset={srcset('overview', 'webp')} sizes={sizes} width="1672" height="941" alt={overview.alt} loading="lazy" decoding="async" />
        </picture>
        <div class="ch__copy">
          <p class="label ch__label">{overview.label}</p>
          <h1 id="hero-h1" class="ch__h1 lines">
            {overview.headline.map((line, i) => <span class="l" style={`--i:${i}`}><span>{line.startsWith('Many ') ? <><em>many</em>{line.slice(4)}</> : line}</span></span>)}
          </h1>
          <p class="ch__support">{overview.support}</p>
        </div>
      </section>

      {worlds.map((w) => (
        <section class="ch ch--world" data-chapter={w.id} data-sector={w.id} aria-labelledby={`world-${w.id}`}>
          <picture class="ch__bg">
            <source type="image/avif" srcset={srcset(w.id, 'avif')} sizes={sizes} />
            <img src={`/media/stills/${w.id}-1200.webp`} srcset={srcset(w.id, 'webp')} sizes={sizes} width="1672" height="941" alt={w.alt} loading="lazy" decoding="async" style={`object-position:${w.focus}`} />
          </picture>
          <div class="ch__copy">
            <p class="label ch__label"><span class="num">{w.n}</span><span class="ch__of"> / 05</span></p>
            <h2 id={`world-${w.id}`} class="display ch__title lines">
              {w.titleLines.map((line, i) => <span class="l" style={`--i:${i}`}><span>{line}</span></span>)}
            </h2>
            <p class="ch__line" style={`--i:${w.titleLines.length}`}>{w.line}</p>
            <a class="tlink label ch__link" href={`/services/#${w.id}`} style={`--i:${w.titleLines.length + 1}`} data-hero-link>{w.linkLabel}<Arrow /></a>
          </div>
        </section>
      ))}

      <section class="ch ch--title" data-chapter="title" aria-labelledby="title-h">
        <h2 id="title-h" class="sr-only">Nexora</h2>
        <!-- Static fallback for the title card: the still shows through the word via a CSS mask. -->
        <div class="ch__word" aria-hidden="true"></div>
        <p class="h1 ch__statement lines" data-title-line>
          <span class="l" style="--i:0"><span>{statement.heading[0]}</span></span>
          <span class="l" style="--i:1"><span><em>{statement.heading[1]}</em></span></span>
        </p>
        <div class="ch__meta label" style="--i:3">
          <span>{site.legalName}</span>
          <span>Est. {site.established} — {site.city}, {site.country}</span>
        </div>
      </section>
    </div>
  </div>
</section>

<style>
  /* ═══ DEFAULT: six ordinary sections ═══════════════════════════════════════════════════ */
  .hero { position: relative; background: var(--studio); color: var(--bone); }
  .hero__media, .hero__mask, .hero__scrim { display: none; }

  /* The five worlds: copy sits on the vertical centre of the calm left third of each composition.
     The scrim is a soft pool around the copy, not a full-height band, so the scene keeps its corners. */
  .hero {
    --scrim-world:
      radial-gradient(ellipse 56% 66% at 0% 50%, rgba(11, 10, 9, 0.8) 0%, rgba(11, 10, 9, 0.56) 42%, rgba(11, 10, 9, 0) 100%),
      linear-gradient(90deg, rgba(11, 10, 9, 0.6) 0%, rgba(11, 10, 9, 0.3) 24%, rgba(11, 10, 9, 0) 50%),
      linear-gradient(180deg, rgba(11, 10, 9, 0.5) 0%, rgba(11, 10, 9, 0) 20%);
  }

  .ch { position: relative; display: flex; align-items: flex-end; min-height: 100vh; min-height: 100svh; padding: calc(var(--header-h) + 2rem) var(--margin) clamp(2.5rem, 7vh, 5rem); overflow: clip; isolation: isolate; }
  .ch + .ch { border-block-start: 1px solid rgba(243, 237, 227, 0.12); }
  .ch__bg { position: absolute; inset: 0; z-index: -2; }
  .ch__bg img { width: 100%; height: 100%; object-fit: cover; }
  .ch::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--scrim-world); }
  .ch--overview .ch__bg img { object-fit: contain; object-position: 50% 40%; }
  .ch--overview::before { background: linear-gradient(0deg, rgba(11, 10, 9, 0.85) 0%, rgba(11, 10, 9, 0) 45%); }
  .ch--world { align-items: center; padding-block: calc(var(--header-h) + 1.5rem); }

  .ch__copy { max-width: min(38vw, 36rem); min-width: min(100%, 19rem); }
  .ch__label { margin-block-end: 1.5rem; }
  .ch__of { opacity: 0.6; }
  .ch__h1 { font-family: var(--f-display); font-stretch: 62.5%; font-weight: 300; text-transform: uppercase; font-size: clamp(2.6rem, 4.8vw, 5.4rem); line-height: 0.9; letter-spacing: -0.005em; }
  .ch__h1 em { font-style: italic; font-stretch: 75%; text-transform: none; color: #f1c28f; }
  .ch__support { margin-block-start: 1.25rem; max-width: 24rem; font-size: var(--t-small); line-height: 1.55; color: var(--bone-soft); }
  /* Each title line is one line by design ('Recruitment' / '& Workforce'): it may run past the copy column, never
     wrap into a third, and never be cut (the line masks clip only vertically). */
  .ch__title { text-shadow: 0 1px 40px rgba(11, 10, 9, 0.45); }
  .ch__title .l > span { white-space: nowrap; }
  .ch__line { margin-block: 1.5rem 1.75rem; max-width: 25rem; font-size: var(--t-lead); line-height: 1.4; }
  .ch__link { color: var(--bone); }

  .ch--title { flex-direction: column; align-items: stretch; justify-content: center; gap: clamp(2rem, 5vw, 4rem); min-height: 80svh; background: var(--studio); }
  .ch--title::before { display: none; }
  .ch__word { width: 100%; aspect-ratio: 4290 / 740; background: url('/media/stills/recruitment-1200.webp') 60% 45% / cover no-repeat var(--bone);
    -webkit-mask: url('/wordmark.svg') center / contain no-repeat; mask: url('/wordmark.svg') center / contain no-repeat; }
  .ch__statement em { color: var(--bronze); }
  .ch__meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 2rem; color: var(--bone-soft); padding-block-start: 1.25rem; border-block-start: 1px solid rgba(243, 237, 227, 0.16); }

  /* ═══ CINEMA: one screen, stepped by gesture ═══════════════════════════════════════════ */
  :global(html.cinema) .hero { height: 100vh; height: 100svh; }
  :global(html.cinema) .hero__stage { position: relative; height: 100%; overflow: clip; background: var(--studio); contain: layout paint; }

  :global(html.cinema) .hero__media { display: block; position: absolute; inset: 0; transform-origin: 50% 50%; will-change: transform; }
  .hero__canvas, .hero__mask { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero__canvas { display: block; touch-action: pan-y; }
  /* Black until the world has drawn its first frame (the intro normally covers this moment). */
  :global(html.cinema) .hero:not([data-ready]) .hero__media { opacity: 0; }
  :global(html.cinema) .hero[data-ready] .hero__media { opacity: 1; transition: opacity 600ms ease-out; }
  :global(html.cinema) .hero__mask { display: block; z-index: 3; pointer-events: none; }

  /* Copy protection, built for the brightest scene (Facilities' pale marble). */
  :global(html.cinema) .hero__scrim { display: block; position: absolute; inset: 0; z-index: 2; pointer-events: none; opacity: 0; transition: opacity 500ms ease; background: var(--scrim-world); }
  :global(html.cinema) .hero__scrim[data-on='true'] { opacity: 1; }
  :global(html.cinema) .hero__scrim[data-mode='overview'] { opacity: 1; background: linear-gradient(0deg, rgba(11, 10, 9, 0.72) 0%, rgba(11, 10, 9, 0) 36%), linear-gradient(180deg, rgba(11, 10, 9, 0.55) 0%, rgba(11, 10, 9, 0) 22%); }


  :global(html.cinema) .hero__ui { position: absolute; inset: 0; z-index: 5; pointer-events: none; }
  :global(html.cinema) .ch { position: absolute; inset: 0; min-height: 0; border: 0; pointer-events: none; background: none; }
  :global(html.cinema) .ch::before, :global(html.cinema) .ch__bg { display: none; }
  :global(html.cinema) .ch[data-active='true'] .ch__copy { pointer-events: auto; }

  /* Copy leaves the instant time resumes; arrives with a hard stop when it freezes.
     Inactive blocks are also transparent: display-serif ascenders overshoot a 0.95 line box, so a
     translate alone leaves glyph tips showing through the line masks of the stacked chapters. */
  :global(html.cinema) .ch .ch__copy { opacity: 0; transition: opacity 0s linear 280ms; }
  :global(html.cinema) .ch[data-active='true'] .ch__copy { opacity: 1; transition-delay: 0s; }
  :global(html.cinema) .ch .l > span { transform: translateY(125%); transition: transform 260ms cubic-bezier(0.5, 0, 0.9, 0.4); }
  :global(html.cinema) .ch .ch__label, :global(html.cinema) .ch .ch__support, :global(html.cinema) .ch .ch__line, :global(html.cinema) .ch .ch__link { opacity: 0; transform: translateY(10px); transition: opacity 200ms ease, transform 200ms ease; }
  :global(html.cinema) .ch[data-active='true'] .l > span { transform: none; transition: transform var(--d-type) var(--ease-freeze); transition-delay: calc(var(--i, 0) * 80ms + 60ms); }
  :global(html.cinema) .ch[data-active='true'] .ch__label, :global(html.cinema) .ch[data-active='true'] .ch__support, :global(html.cinema) .ch[data-active='true'] .ch__line, :global(html.cinema) .ch[data-active='true'] .ch__link { opacity: 1; transform: none; transition: opacity 520ms ease-out, transform 520ms var(--ease-freeze); transition-delay: calc(var(--i, 0) * 80ms + 140ms); }

  :global(html.cinema) .ch--overview .ch__copy { max-width: min(30vw, 27rem); }

  /* In the live film the world's name stands in the scene as monumental letters, so the page copy steps down to a
     caption at the foot of the frame: number, one line, the link. The name stays in the DOM for readers. */
  :global(html.cinema) .ch--world { align-items: flex-end; padding-block: calc(var(--header-h) + 1rem) clamp(2.5rem, 9vh, 6rem); }
  :global(html.cinema) .ch--world .ch__copy { max-width: min(28rem, 32vw); }
  :global(html.cinema) .ch--world .ch__title { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  :global(html.cinema) .ch--world .ch__label { margin-block-end: 0.9rem; }
  :global(html.cinema) .ch--world .ch__line { margin-block: 0 1.35rem; font-size: clamp(1rem, 1.15vw, 1.1875rem); }
  :global(html.cinema) .hero { --scrim-world: radial-gradient(ellipse 48% 42% at 0% 100%, rgba(5, 6, 8, 0.72) 0%, rgba(5, 6, 8, 0.38) 45%, rgba(5, 6, 8, 0) 100%); }
  :global(html.cinema) .ch--title { display: block; padding: 0; min-height: 0; background: none; }
  :global(html.cinema) .ch--title .ch__statement { opacity: 0; transition: opacity 0s linear 280ms; }
  :global(html.cinema) .ch--title[data-active='true'] .ch__statement { opacity: 1; transition-delay: 0s; }
  :global(html.cinema) .ch__word { display: none; }
  :global(html.cinema) .ch__statement { position: absolute; inset-inline: 6vw; inset-block-start: var(--title-y, 62%); max-width: 16em; }
  :global(html.cinema) .ch__meta { position: absolute; inset-inline: 6vw; inset-block-end: clamp(1.5rem, 5vh, 3.25rem); opacity: 0; transition: opacity 200ms ease; }
  :global(html.cinema) .ch[data-active='true'] .ch__meta { opacity: 1; transition: opacity 700ms ease-out 500ms; }

  /* ═══ PORTRAIT ═════════════════════════════════════════════════════════════════════════
     The portrait crop is built around the action (x ≈ 0.72), which fills the middle of the screen. Centred copy
     would sit on the people, so here the worlds keep a lower-third block over a bottom scrim — deliberately. */
  @media (max-aspect-ratio: 999/1000) {
    .hero { --scrim-world: linear-gradient(0deg, rgba(11, 10, 9, 0.94) 0%, rgba(11, 10, 9, 0.72) 28%, rgba(11, 10, 9, 0) 58%), linear-gradient(180deg, rgba(11, 10, 9, 0.6) 0%, rgba(11, 10, 9, 0) 18%); }
    .ch, .ch--world { align-items: flex-end; padding-block: calc(var(--header-h) + 2rem) calc(clamp(1.75rem, 5vh, 3rem) + env(safe-area-inset-bottom, 0px)); }
    .ch--overview::before { background: var(--scrim-world); }
    .ch__copy, :global(html.cinema) .ch--overview .ch__copy { max-width: 100%; }
    .ch__bg img { object-position: 74% 50% !important; }
    .ch--overview .ch__bg img { object-position: 50% 34% !important; }
    .ch__h1 { font-size: clamp(2.5rem, 11vw, 4rem); }
    .ch__title { font-size: clamp(2.75rem, 12.5vw, 4.5rem); }
    .ch__line { font-size: 1.0625rem; margin-block: 1rem 1.25rem; }
    .ch__link { display: flex; justify-content: space-between; padding-block: 0.9rem; border-block-start: 1px solid rgba(243, 237, 227, 0.3); }
    .ch__link::after, .ch__link::before { display: none; }

    :global(html.cinema) .hero__scrim[data-mode='overview'] { background: var(--scrim-world); }
    :global(html.cinema) .ch__statement { inset-inline: var(--margin); font-size: clamp(2rem, 9vw, 3rem); }
  }
  /* Phone landscape: little height, so the type floor drops. */
  @media (max-height: 520px) and (min-aspect-ratio: 1/1) {
    .ch--world { padding-block: calc(var(--header-h) + 0.5rem) 1rem; }
    .ch__title { font-size: clamp(2rem, 5.2vw, 3.25rem); }
    .ch__label { margin-block-end: 0.75rem; }
    .ch__line { font-size: 1rem; margin-block: 0.75rem 1rem; }
    .ch__support { display: none; }
  }
</style>
