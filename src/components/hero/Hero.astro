---
/**
 * The film, version 5: a living mashrabiya, and behind it five moments of work held in time.
 * See docs/redesign/05-HERO-V5.md.
 *
 * DEFAULT (no JS, reduced motion, Save-Data): six ordinary sections on limestone — the overview with its moment in
 * a circle, the five worlds each in an arch, the title card — complete and readable.
 *
 * html.cinema (set pre-paint): the same markup becomes ONE screen-high stage; the chapters stack over a WebGL canvas
 * that draws the screen (src/scripts/hero/screen), stepped by gesture. The canvas publishes where its opening is
 * (--arch-*, --circle-*), and every copy block stands on the arch's foot, so text and window share one ground line.
 * There is deliberately no HUD.
 */
import Arrow from '../ui/Arrow.astro';
import { worlds, overview } from '../../data/worlds';
import { statement } from '../../data/content';
import { site } from '../../data/site';
const img = (id: string) => `/media/hero5/${id}-900.webp`;
const srcset = (id: string) => `/media/hero5/${id}-900.webp 900w, /media/hero5/${id}-1400.webp 1400w`;
---
<section class="hero" id="film" data-hero data-header-clear data-theme="paper" data-bg="light" aria-label="Introduction">
  <div class="hero__stage" data-stage>
    <div class="hero__media" data-media>
      <!-- The film: one fragment shader, drawn by src/scripts/hero/screen. -->
      <canvas class="hero__canvas" data-canvas role="img" aria-label={overview.alt}></canvas>
    </div>
    <canvas class="hero__mask" data-mask aria-hidden="true"></canvas>

    <div class="hero__ui">
      <section class="ch ch--overview" data-chapter="overview" data-active="true" aria-labelledby="hero-h1">
        <figure class="ch__frame ch__frame--circle" aria-hidden="true">
          <img src={img(worlds[0].id)} srcset={srcset(worlds[0].id)} sizes="(max-aspect-ratio: 1/1) 90vw, 46vw" width="1400" height="1556" alt="" loading="lazy" decoding="async" />
        </figure>
        <div class="ch__copy">
          <p class="label ch__label">{overview.label}</p>
          <h1 id="hero-h1" class="ch__h1 lines">
            {overview.headline.map((line, i) => <span class="l" style={`--i:${i}`}><span>{line.startsWith('Many ') ? <><em>many</em>{line.slice(4)}</> : line}</span></span>)}
          </h1>
          <p class="ch__support" style="--i:2">{overview.support}</p>
        </div>
      </section>

      {worlds.map((w) => (
        <section class="ch ch--world" data-chapter={w.id} data-sector={w.id} aria-labelledby={`world-${w.id}`}>
          <figure class="ch__frame">
            <img src={img(w.id)} srcset={srcset(w.id)} sizes="(max-aspect-ratio: 1/1) 90vw, 46vw" width="1400" height="1556" alt={w.moment} loading="lazy" decoding="async" />
          </figure>
          <div class="ch__copy">
            <p class="label ch__label"><span class="num">{w.n}</span><span class="ch__rule" aria-hidden="true"></span><span class="ch__of">05</span></p>
            <h2 id={`world-${w.id}`} class="display ch__title lines">
              {w.titleLines.map((line, i) => <span class="l" style={`--i:${i}`}><span>{line}</span></span>)}
            </h2>
            <p class="ch__line" style={`--i:${w.titleLines.length}`}>{w.line}</p>
            <a class="tlink label ch__link" href={`/services/#${w.id}`} style={`--i:${w.titleLines.length + 1}`} data-hero-link>{w.linkLabel}<Arrow /></a>
          </div>
        </section>
      ))}

      <section class="ch ch--title" data-chapter="title" aria-labelledby="title-h">
        <h2 id="title-h" class="sr-only">Nexora</h2>
        <!-- Static fallback for the title card: a moment shows through the word via a CSS mask. -->
        <div class="ch__word" aria-hidden="true"></div>
        <p class="h1 ch__statement lines" data-title-line>
          <span class="l" style="--i:0"><span>{statement.heading[0]}</span></span>
          <span class="l" style="--i:1"><span><em>{statement.heading[1]}</em></span></span>
        </p>
        <div class="ch__meta label" style="--i:3">
          <span>{site.legalName}</span>
          <span>Est. {site.established} — {site.city}, {site.country}</span>
        </div>
      </section>
    </div>
  </div>
</section>

<style>
  /* ═══ DEFAULT: six ordinary sections on limestone ═══════════════════════════════════════ */
  .hero { position: relative; background: var(--sand); color: var(--ink); }
  .hero__media, .hero__mask { display: none; }

  .ch {
    position: relative; display: grid; align-items: end;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr); gap: clamp(2rem, 5vw, 6rem);
    min-height: 100vh; min-height: 100svh;
    padding: calc(var(--header-h) + 2rem) var(--margin) clamp(2.5rem, 7vh, 5rem);
  }
  .ch + .ch { border-block-start: 1px solid var(--line-soft); }
  .ch__frame { grid-column: 2; grid-row: 1; align-self: stretch; margin: 0; overflow: hidden; border-radius: 999px 999px 0 0 / 50% 50% 0 0; max-height: 82vh; }
  .ch__frame--circle { border-radius: 50%; aspect-ratio: 1; align-self: center; max-height: none; }
  .ch__frame img { width: 100%; height: 100%; object-fit: cover; }
  .ch__copy { grid-column: 1; grid-row: 1; max-width: 34rem; }

  .ch__label { display: flex; align-items: center; gap: 0.9em; margin-block-end: 1.4rem; color: var(--ink-soft); }
  .ch__rule { width: 2.25rem; height: 1px; background: currentColor; opacity: 0.5; }
  .ch__h1 { font-family: var(--f-display); font-stretch: 62.5%; font-weight: 300; text-transform: uppercase; font-size: clamp(3rem, 6.6vw, 8.4rem); line-height: 0.88; letter-spacing: -0.006em; }
  .ch__h1 em { font-style: italic; font-stretch: 75%; text-transform: none; color: var(--amber-deep); }
  .ch__support { margin-block-start: 1.5rem; max-width: 25rem; font-size: var(--t-body); line-height: 1.55; color: var(--ink-soft); }
  .ch__title { font-size: clamp(2.75rem, 5.4vw, 6.8rem); line-height: 0.9; }
  .ch__title .l > span { white-space: nowrap; }
  .ch__line { margin-block: 1.5rem 1.75rem; max-width: 26rem; font-size: var(--t-lead); line-height: 1.45; }
  .ch__link { color: var(--ink); }

  .ch--title { display: flex; flex-direction: column; align-items: stretch; justify-content: center; gap: clamp(2rem, 5vw, 4rem); min-height: 80svh; background: var(--studio); color: var(--bone); }
  .ch__word { width: 100%; aspect-ratio: 4290 / 740; background: url('/media/hero5/facilities-1400.webp') 50% 45% / cover no-repeat var(--bone);
    -webkit-mask: url('/wordmark.svg') center / contain no-repeat; mask: url('/wordmark.svg') center / contain no-repeat; }
  .ch__statement em { color: var(--amber); }
  .ch__meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 2rem; color: var(--bone-soft); padding-block-start: 1.25rem; border-block-start: 1px solid rgba(243, 237, 227, 0.16); }

  /* ═══ CINEMA: one screen, stepped by gesture ═══════════════════════════════════════════ */
  :global(html.cinema) .hero { height: 100vh; height: 100svh; }
  :global(html.cinema) .hero__stage { position: relative; height: 100%; overflow: clip; background: #ebe4d8; contain: layout paint; }
  :global(html.cinema) .hero__media { display: block; position: absolute; inset: 0; transform-origin: 50% 50%; will-change: transform; }
  .hero__canvas, .hero__mask { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero__canvas { display: block; touch-action: pan-y; }
  :global(html.cinema) .hero:not([data-ready]) .hero__media { opacity: 0; }
  :global(html.cinema) .hero[data-ready] .hero__media { opacity: 1; transition: opacity 600ms ease-out; }
  :global(html.cinema) .hero__mask { display: block; z-index: 3; pointer-events: none; }

  :global(html.cinema) .hero__ui { position: absolute; inset: 0; z-index: 5; pointer-events: none; }
  :global(html.cinema) .ch { display: block; position: absolute; inset: 0; min-height: 0; padding: 0; border: 0; pointer-events: none; background: none; }
  :global(html.cinema) .ch__frame { display: none; }
  :global(html.cinema) .ch[data-active='true'] .ch__copy { pointer-events: auto; }

  /* Every block stands on the arch's foot: one ground line for window and words. */
  :global(html.cinema) .ch__copy {
    position: absolute; inset-inline-start: var(--margin);
    inset-block-end: calc(100% - var(--arch-bottom, 94%));
    width: calc(var(--arch-left, 52vw) - var(--margin) * 2.2); max-width: 40rem;
  }
  :global(html.cinema) .ch--world .ch__copy { max-width: 31rem; }

  /* Copy leaves the instant time resumes; arrives as the window opens and settles. */
  :global(html.cinema) .ch .ch__copy { opacity: 0; transition: opacity 0s linear 300ms; }
  :global(html.cinema) .ch[data-active='true'] .ch__copy { opacity: 1; transition-delay: 0s; }
  :global(html.cinema) .ch .l > span { transform: translateY(118%); transition: transform 280ms cubic-bezier(0.5, 0, 0.9, 0.4); }
  :global(html.cinema) .ch .ch__label, :global(html.cinema) .ch .ch__support, :global(html.cinema) .ch .ch__line, :global(html.cinema) .ch .ch__link { opacity: 0; transform: translateY(12px); transition: opacity 220ms ease, transform 220ms ease; }
  :global(html.cinema) .ch[data-active='true'] .l > span { transform: none; transition: transform var(--d-type) var(--ease-freeze); transition-delay: calc(var(--i, 0) * 90ms + 80ms); }
  :global(html.cinema) .ch[data-active='true'] .ch__label, :global(html.cinema) .ch[data-active='true'] .ch__support, :global(html.cinema) .ch[data-active='true'] .ch__line, :global(html.cinema) .ch[data-active='true'] .ch__link { opacity: 1; transform: none; transition: opacity 600ms ease-out, transform 700ms var(--ease-freeze); transition-delay: calc(var(--i, 0) * 90ms + 160ms); }

  /* The title card: the black of the NEXORA knock-out, light type (unchanged from v4). */
  :global(html.cinema) .ch--title { display: block; padding: 0; min-height: 0; background: none; color: var(--bone); }
  :global(html.cinema) .ch--title .ch__statement { opacity: 0; transition: opacity 0s linear 280ms; }
  :global(html.cinema) .ch--title[data-active='true'] .ch__statement { opacity: 1; transition-delay: 0s; }
  :global(html.cinema) .ch__word { display: none; }
  :global(html.cinema) .ch__statement { position: absolute; inset-inline: 6vw; inset-block-start: var(--title-y, 62%); max-width: 16em; }
  :global(html.cinema) .ch__meta { position: absolute; inset-inline: 6vw; inset-block-end: clamp(1.5rem, 5vh, 3.25rem); opacity: 0; transition: opacity 200ms ease; }
  :global(html.cinema) .ch[data-active='true'] .ch__meta { opacity: 1; transition: opacity 700ms ease-out 500ms; }

  /* ═══ UPRIGHT SCREENS ══════════════════════════════════════════════════════════════════
     The window stands at the top; the words stand under it, on its foot. */
  @media (max-aspect-ratio: 104/100) {
    .ch { grid-template-columns: 1fr; align-content: end; gap: 2rem; }
    .ch__frame, .ch__copy { grid-column: 1; }
    .ch__frame { grid-row: 1; max-height: 52vh; aspect-ratio: 4 / 5; }
    .ch__frame--circle { aspect-ratio: 1; width: min(100%, 52vh); justify-self: center; }
    .ch__copy { grid-row: 2; }
    .ch__h1 { font-size: clamp(2.6rem, 12.4vw, 4.6rem); }
    .ch__title { font-size: clamp(2.5rem, 11.8vw, 4.4rem); }
    .ch__line { font-size: 1.0625rem; margin-block: 1rem 1.25rem; }
    .ch__support { margin-block-start: 1rem; }
    .ch__link { display: flex; justify-content: space-between; padding-block: 0.9rem; border-block-start: 1px solid var(--line); }
    .ch__link::after, .ch__link::before { display: none; }

    :global(html.cinema) .ch__copy { inset-block: calc(var(--arch-bottom, 58%) + clamp(1.25rem, 3.2vh, 2rem)) auto; inset-inline: var(--margin); width: auto; max-width: none; }
    :global(html.cinema) .ch--world .ch__copy { max-width: none; }
    :global(html.cinema) .ch__statement { inset-inline: var(--margin); font-size: clamp(2rem, 9vw, 3rem); }
  }
  /* Short upright phones (SE and the like): the window has taken its share, the words tighten to fit under it. */
  @media (max-aspect-ratio: 104/100) and (max-height: 720px) {
    :global(html.cinema) .ch__copy { inset-block-start: calc(var(--arch-bottom, 58%) + 0.9rem); }
    .ch__label { margin-block-end: 0.8rem; }
    .ch__h1 { font-size: clamp(2.3rem, 10.6vw, 3.4rem); }
    .ch__title { font-size: clamp(2.2rem, 10.2vw, 3.3rem); }
    .ch__line { font-size: 0.975rem; margin-block: 0.7rem 0.6rem; }
    .ch__link { padding-block: 0.7rem; }
    :global(html.cinema) .ch--overview .ch__support { display: none; }
  }
  /* Phones on their side: little height, so the type floor drops. */
  @media (max-height: 520px) and (min-aspect-ratio: 1/1) {
    .ch__title { font-size: clamp(2rem, 5.2vw, 3.25rem); }
    .ch__h1 { font-size: clamp(2.2rem, 6vw, 3.6rem); }
    .ch__label { margin-block-end: 0.75rem; }
    .ch__line { font-size: 1rem; margin-block: 0.75rem 1rem; }
    .ch__support { display: none; }
  }
</style>
