---
/**
 * The intro.
 *
 * Studio black. NEXORA sits at the centre and tracks open as the film's real bytes arrive; a hairline grows
 * beneath it; the five world names cycle in their own colours. It ends by drawing the hairline in to a point,
 * which opens as a circular aperture with a lit rim (the disc's own edge) and dives out past the corners while
 * the film behind it settles from a slight zoom onto the disc already turning.
 *
 * Visibility is decided BEFORE first paint by the inline script in Base.astro (`html[data-intro]`), so the hero
 * is never visible for a frame first. Without JS the attribute is never set and this markup never displays.
 * `src/scripts/intro.ts` drives it from there.
 */
import { worlds } from '../data/worlds';
import { site } from '../data/site';
---
<div class="intro" data-intro-root role="presentation">
  <div class="intro__grain" aria-hidden="true"></div>

  <p class="intro__corner intro__corner--tl label">{site.legalName}</p>
  <p class="intro__corner intro__corner--bl label">{site.city}, {site.country}</p>
  <p class="intro__corner intro__corner--br label">Est. {site.established}</p>

  <div class="intro__centre">
    <p class="intro__word" data-intro-word aria-hidden="true">NEXORA</p>

    <div class="intro__bar">
      <span class="intro__track"></span>
      <span class="intro__fill" data-intro-fill></span>
    </div>

    <div class="intro__foot">
      <span class="intro__worlds" data-intro-worlds>
        {worlds.map((w, i) => (
          <span class="intro__world label" data-sector={w.id} data-i={i}><span>{w.title}</span></span>
        ))}
        <span class="intro__world intro__world--final label" data-i="5"><span>{site.tagline}</span></span>
      </span>
      <span class="intro__pct label" data-intro-pct>00</span>
    </div>
  </div>

  <!-- The aperture's lit rim. The field itself is cut by a radial mask driven from --r. -->
  <span class="intro__ring" data-intro-ring aria-hidden="true"></span>
</div>

<style>
  .intro { display: none; }
  :global(html[data-intro]) .intro {
    display: grid; place-items: center;
    position: fixed; inset: 0; z-index: 300;
    background: var(--studio); color: var(--bone);
  }
  .intro[data-done='true'] { visibility: hidden; pointer-events: none; }
  .intro__grain { position: absolute; inset: 0; background-image: var(--grain-url); background-size: 180px 180px; opacity: 0.4; mix-blend-mode: overlay; }

  .intro__corner { position: absolute; color: var(--bone-soft); opacity: 0; transition: opacity 800ms ease-out 240ms; }
  .intro__corner--tl { inset-block-start: clamp(1.25rem, 4vh, 2.5rem); inset-inline-start: var(--margin); }
  .intro__corner--bl { inset-block-end: clamp(1.25rem, 4vh, 2.5rem); inset-inline-start: var(--margin); }
  .intro__corner--br { inset-block-end: clamp(1.25rem, 4vh, 2.5rem); inset-inline-end: var(--margin); }
  .intro[data-on='true'] .intro__corner { opacity: 1; }

  .intro__centre { width: min(46rem, calc(100vw - var(--margin) * 2)); }

  /* The wordmark IS the progress bar: it tracks open as the film arrives (Lambert | Lambert). */
  .intro__word {
    font-family: var(--f-label); font-stretch: 125%; font-weight: 500;
    font-size: clamp(1.05rem, 2vw, 1.75rem);
    line-height: 1;
    text-align: center;
    letter-spacing: var(--track, 0.06em);
    text-indent: var(--track, 0.06em); /* keeps the optical centre while the tracking grows */
    margin-block-end: clamp(1rem, 2.6vh, 1.75rem);
    opacity: 0;
    transition: opacity 900ms ease-out 200ms;
  }
  .intro[data-on='true'] .intro__word { opacity: 1; }

  .intro__bar { position: relative; height: 1px; }
  .intro__track { position: absolute; inset: 0; background: rgba(243, 237, 227, 0.14); transform: scaleX(0); transition: transform 1000ms var(--ease-freeze) 160ms; }
  .intro[data-on='true'] .intro__track { transform: none; }
  .intro__fill { position: absolute; inset-block: 0; inset-inline-start: 0; width: 100%; background: var(--amber); transform: scaleX(0); transform-origin: left; }

  .intro__foot { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-block-start: 0.85rem; }

  /* World names are stacked in one box and cross-faded, so nothing reflows as they change. */
  .intro__worlds { position: relative; display: block; height: 1.3em; flex: 1; min-width: 0; }
  .intro__world { position: absolute; inset-block-start: 0; inset-inline-start: 0; white-space: nowrap; color: var(--accent, var(--amber)); opacity: 0; transition: opacity 260ms linear; }
  .intro__world > span { display: block; transform: translateY(0.45em); transition: transform 460ms var(--ease-freeze); }
  .intro__world[data-on='true'] { opacity: 1; }
  .intro__world[data-on='true'] > span { transform: none; }
  .intro__world--final { color: var(--bone); }

  .intro__pct { color: var(--bone-soft); font-variant-numeric: tabular-nums; }
  .intro__pct::after { content: '%'; opacity: 0.4; margin-inline-start: 0.15em; }

  /* The close: the hairline draws in to its centre, everything else fades, and a point of light remains. */
  .intro[data-close] .intro__track,
  .intro[data-close] .intro__fill { transform-origin: 50% 50%; transform: scaleX(0) !important; transition: transform 620ms var(--ease-io); }
  .intro[data-close] .intro__word,
  .intro[data-close] .intro__foot,
  .intro[data-close] .intro__corner { opacity: 0; transition: opacity 380ms linear; }

  /* The aperture. --r is animated from JS; the mask keeps the field everywhere outside the circle. */
  .intro[data-aperture] {
    -webkit-mask-image: radial-gradient(circle at 50% 50%, transparent var(--r, 0px), #000 calc(var(--r, 0px) + 1px));
    mask-image: radial-gradient(circle at 50% 50%, transparent var(--r, 0px), #000 calc(var(--r, 0px) + 1px));
  }
  .intro__ring {
    position: fixed; inset-block-start: 50%; inset-inline-start: 50%;
    width: calc(var(--r, 1.5px) * 2 + 2px); height: calc(var(--r, 1.5px) * 2 + 2px);
    translate: -50% -50%;
    border-radius: 50%;
    border: 1px solid #f0bd86;
    background: radial-gradient(circle, rgba(240, 189, 134, calc(0.9 - var(--open, 0) * 0.9)) 0 40%, transparent 72%);
    box-shadow: 0 0 22px 1px rgba(224, 164, 107, 0.55), inset 0 0 26px rgba(224, 164, 107, 0.26);
    opacity: 0; pointer-events: none;
  }
  .intro[data-close] .intro__ring { opacity: var(--ring, 1); transition: opacity 260ms linear 420ms; }
  .intro[data-aperture] .intro__ring { transition: none; }

  @media (max-width: 699px) {
    .intro__corner--br { display: none; }
    .intro__world { font-size: 0.625rem; }
  }
</style>
