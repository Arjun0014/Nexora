---
/** The conversion moment for both audiences. Each whole panel is the link; hierarchy is 7 / 5. */
import Arrow from '../ui/Arrow.astro';
import { doors } from '../../data/content';
const list = [{ ...doors.employer, kind: 'employer' }, { ...doors.candidate, kind: 'candidate' }];
---
<section class="dr surface" id="start" data-theme="dark" aria-label="Start here">
  {list.map((d) => (
    <a class={`dr__door dr__door--${d.kind}`} href={d.href} data-cursor={d.cursor}>
      <span class="label dr__label">{d.label}</span>
      <span class="mega dr__head">{d.heading.map((line) => <span>{line}</span>)}</span>
      <span class="dr__foot">
        <span class="lead dr__body">{d.body}</span>
        <span class="label dr__cta">{d.cta}<Arrow /></span>
      </span>
    </a>
  ))}
</section>

<style>
  .dr { display: grid; grid-template-columns: 7fr 5fr; border-block-start: 1px solid var(--line); }
  .dr__door { position: relative; display: grid; grid-template-rows: auto 1fr auto; gap: 2rem; min-block-size: min(88svh, 52rem); padding: clamp(2rem, 4vw, 4.5rem) var(--margin); isolation: isolate; overflow: clip; transition: color 420ms ease; }
  .dr__door + .dr__door { border-inline-start: 1px solid var(--line); }
  .dr__door::before { content: ''; position: absolute; inset: 0; z-index: -1; transform: scaleY(0); transform-origin: bottom; transition: transform 620ms var(--ease-freeze); }
  .dr__door--employer::before { background: var(--bronze); }
  .dr__door--candidate::before { background: var(--studio-2); }
  .dr__door:hover::before, .dr__door:focus-visible::before { transform: scaleY(1); }
  .dr__door--employer:hover, .dr__door--employer:focus-visible { color: var(--studio); }
  .dr__door:focus-visible { outline-offset: -6px; }

  .dr__head { display: grid; align-self: center; }
  .dr__door--candidate .dr__head { font-size: clamp(2.75rem, 7.2vw, 8rem); }
  .dr__foot { display: grid; gap: 1.75rem; max-inline-size: 26rem; }
  .dr__body { opacity: 0.78; }
  .dr__cta { display: inline-flex; align-items: center; gap: 0.9em; }
  .dr__label { opacity: 0.7; }

  @media (max-width: 899px) {
    .dr { grid-template-columns: 1fr; }
    .dr__door { min-block-size: 46svh; }
    .dr__door + .dr__door { border-inline-start: 0; border-block-start: 1px solid var(--line); }
    .dr__door--candidate .dr__head { font-size: clamp(2.75rem, 11vw, 5rem); }
  }
</style>
