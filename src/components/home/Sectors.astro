---
/** A typographic index. After the deck the eye needs type, so there are no images and no icons here. */
import Arrow from '../ui/Arrow.astro';
import { sectors } from '../../data/content';
---
<section class="sx surface section cv-auto" id="sectors" data-theme="paper" aria-labelledby="sx-h">
  <div class="wrap">
    <header class="sx__head grid" data-reveal>
      <p class="label label--soft sx__label" data-rise>Where our people work</p>
      <h2 id="sx-h" class="h1 sx__title lines">
        <span class="l" style="--i:0"><span>Ten sectors.</span></span>
        <span class="l" style="--i:1"><span>Construction isn’t one.</span></span>
      </h2>
    </header>

    <ol class="sx__list">
      {sectors.map((s, i) => (
        <li>
          <a class="sx__row" href={`/industries/#${s.id}`}>
            <span class="label num sx__n">{String(i + 1).padStart(2, '0')}</span>
            <span class="h2 sx__name">{s.name}</span>
            <span class="small sx__roles">{s.roles}</span>
            <Arrow class="sx__arrow" />
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .sx__head { row-gap: 1.5rem; margin-block-end: var(--space-s); }
  .sx__label { grid-column: 1 / span 2; padding-block-start: 0.9rem; }
  .sx__title { grid-column: 3 / -1; }

  .sx__list { border-block-end: 1px solid var(--line); }
  .sx__row { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: baseline; padding-block: clamp(0.9rem, 1.6vw, 1.5rem); border-block-start: 1px solid var(--line); transition: opacity var(--d-state) ease; }
  .sx__n { grid-column: 1 / span 2; }
  .sx__name { grid-column: 3 / span 6; transition: transform var(--d-reveal) var(--ease-freeze); }
  .sx__roles { grid-column: 9 / span 3; color: var(--fg-soft); transition: color var(--d-state) ease; }
  .sx__row :global(.sx__arrow) { grid-column: 12; justify-self: end; align-self: center; opacity: 0; color: var(--bronze-deep); }

  /* One row in focus; the rest recede. Hover-capable devices only — on touch everything is simply visible. */
  @media (hover: hover) {
    .sx__list:hover .sx__row:not(:hover), .sx__list:focus-within .sx__row:not(:focus-visible) { opacity: 0.35; }
    .sx__row:hover .sx__name, .sx__row:focus-visible .sx__name { transform: translateX(0.75rem); }
    .sx__row:hover .sx__roles, .sx__row:focus-visible .sx__roles { color: var(--fg); }
    .sx__row:hover :global(.sx__arrow), .sx__row:focus-visible :global(.sx__arrow) { opacity: 1; }
  }
  [dir='rtl'] .sx__row:hover .sx__name { transform: translateX(-0.75rem); }

  @media (max-width: 1023px) {
    .sx__label, .sx__title { grid-column: 1 / -1; }
    .sx__row { grid-template-columns: 2.5rem 1fr; row-gap: 0.35rem; }
    .sx__n { grid-column: 1; grid-row: 1; align-self: start; padding-block-start: 0.7em; }
    .sx__name { grid-column: 2; }
    .sx__roles { grid-column: 2; color: var(--fg); opacity: 0.72; }
    .sx__row :global(.sx__arrow) { display: none; }
  }
</style>
