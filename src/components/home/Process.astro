---
/**
 * How an engagement runs. Constant layout, changing content: a sticky numeral on the left,
 * the five steps scrolling on the right. Below 900px nothing is sticky and each step carries its own numeral.
 */
import { process } from '../../data/content';
---
<section class="pr surface section" id="process" data-theme="paper" data-process aria-labelledby="pr-h">
  <div class="wrap grid">
    <div class="pr__aside">
      <div class="pr__sticky">
        <p class="label label--soft">{process.label}</p>
        <h2 id="pr-h" class="h1 pr__title lines" data-reveal>
          {process.heading.map((line, i) => <span class="l" style={`--i:${i}`}><span>{line}</span></span>)}
        </h2>
        <p class="body soft pr__intro">{process.intro}</p>
        <div class="pr__big" aria-hidden="true">
          <div class="pr__reel" data-process-reel>
            {process.steps.map((s) => <span>{s.n}</span>)}
          </div>
        </div>
      </div>
    </div>

    <ol class="pr__steps">
      {process.steps.map((s, i) => (
        <li class="pr__step" data-process-step={i}>
          <p class="label num pr__n">{s.n}</p>
          <h3 class="display pr__name">{s.title}</h3>
          <p class="lead pr__body">{s.body}</p>
          <p class="pr__approve"><span class="label label--soft">You approve</span><span>{s.approve}</span></p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .pr { border-block-start: 1px solid var(--line); }
  .pr__aside { grid-column: 1 / span 5; }
  .pr__sticky { position: sticky; inset-block-start: calc(var(--header-h) + 2rem); display: grid; gap: 1.5rem; align-content: start; }
  .pr__intro { max-width: 24rem; }
  .pr__big { block-size: clamp(9rem, 19vw, 19rem); overflow: clip; margin-block-start: 1rem; font-family: var(--f-display); font-size: clamp(9rem, 19vw, 19rem); line-height: 1; letter-spacing: -0.04em; color: var(--bronze-deep); }
  .pr__reel { display: grid; transform: translateY(calc(var(--step, 0) * -1em)); transition: transform 620ms var(--ease-freeze); }
  .pr__reel span { block-size: 1em; display: block; }

  .pr__steps { grid-column: 7 / -1; }
  .pr__step { display: grid; gap: 1.25rem; padding-block: clamp(3rem, 7vw, 6rem); border-block-start: 1px solid var(--line); opacity: 0.32; transition: opacity 420ms ease; }
  .pr__step:first-child { border-block-start: 0; padding-block-start: 0; }
  .pr__step[data-current], :global(html:not(.motion)) .pr__step { opacity: 1; }
  .pr__n { display: none; }
  .pr__body { max-width: 30rem; }
  .pr__approve { display: grid; grid-template-columns: 7.5rem 1fr; align-items: baseline; gap: 1rem; padding-block-start: 1.1rem; border-block-start: 1px solid var(--line); max-width: 30rem; }

  @media (max-width: 899px) {
    .pr__aside, .pr__steps { grid-column: 1 / -1; }
    .pr__sticky { position: static; margin-block-end: var(--space-s); }
    .pr__big { display: none; }
    .pr__n { display: block; }
    .pr__step { opacity: 1; padding-block: 2.5rem; }
    .pr__step:first-child { border-block-start: 1px solid var(--line); padding-block-start: 2.5rem; }
  }
</style>
