---
/**
 * Five workforces — the site's one tactile interaction.
 *
 * Markup is an ordered list of five complete articles. That IS the no-JS / reduced-motion presentation.
 * src/scripts/deck.ts upgrades it: the images become a draggable stack and the articles become a
 * single cross-fading detail panel. Information never depends on the gesture.
 */
import Arrow from '../ui/Arrow.astro';
import { worlds } from '../../data/worlds';
import { engagements } from '../../data/content';
---
<section class="wf surface section" id="workforces" data-theme="dark" aria-labelledby="wf-h">
  <div class="wrap">
    <header class="wf__head grid" data-reveal>
      <p class="label label--soft wf__label" data-rise>What we supply</p>
      <h2 id="wf-h" class="h1 wf__title lines">
        <span class="l" style="--i:0"><span>Five workforces.</span></span>
        <span class="l" style="--i:1"><span>One partner.</span></span>
      </h2>
    </header>

    <div class="deck" data-deck data-sector={worlds[0].id}>
      <ol class="deck__list" data-deck-list>
        {worlds.map((w, i) => (
          <li class="deck__item" data-deck-item data-sector={w.id} data-index={i}>
            <article class="deck__panel" data-deck-panel id={`wf-${w.id}`} aria-labelledby={`wf-${w.id}-h`}>
              <p class="label deck__n"><span class="num">{w.n}</span><span class="soft"> / 05</span></p>
              <h3 id={`wf-${w.id}-h`} class="display deck__title">{w.title}</h3>
              <p class="lead deck__body">{w.body}</p>
              <div class="deck__roles">
                <h4 class="label label--soft">Typical roles</h4>
                <ul>{w.roles.map((r) => <li>{r}</li>)}</ul>
              </div>
              <a class="tlink label" href={`/request/?workforce=${w.id}`}>Request this workforce<Arrow /></a>
            </article>
            <figure class="deck__card" data-deck-card>
              <picture>
                <source type="image/avif" srcset={`/media/stills/${w.id}-card-480.avif 480w, /media/stills/${w.id}-card-720.avif 720w`} sizes="(max-width: 1023px) 78vw, 34vw" />
                <img src={`/media/stills/${w.id}-card-720.webp`} srcset={`/media/stills/${w.id}-card-480.webp 480w, /media/stills/${w.id}-card-720.webp 720w`} sizes="(max-width: 1023px) 78vw, 34vw" width="720" height="900" alt={w.alt} loading="lazy" decoding="async" draggable="false" />
              </picture>
              <figcaption class="chip label deck__cap"><span class="num">{w.n}</span>{w.short} · {w.frozen}</figcaption>
            </figure>
          </li>
        ))}
      </ol>

      <!-- Rendered only once the deck is live. -->
      <div class="deck__ctrl" data-deck-ctrl hidden>
        <button class="deck__btn" type="button" data-deck-prev aria-label="Previous workforce"><Arrow /></button>
        <p class="label deck__count" aria-live="off"><span data-deck-count>01</span><span class="soft"> / 05</span></p>
        <button class="deck__btn" type="button" data-deck-next aria-label="Next workforce"><Arrow /></button>
        <p class="label label--soft deck__hint">Drag, or use ← →</p>
      </div>
    </div>

    <div class="eng" data-reveal>
      <h3 class="label label--soft eng__label" data-rise>Ways to engage</h3>
      <ul class="eng__list">
        {engagements.map((e, i) => (
          <li class="eng__item" data-rise style={`--i:${i + 1}`}>
            <a href={`/services/#${e.id}`} class="eng__link">
              <span class="h3">{e.title}</span>
              <span class="small soft">{e.body}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .wf__head { row-gap: 1.5rem; margin-block-end: var(--space-s); }
  .wf__label { grid-column: 1 / span 2; padding-block-start: 0.9rem; }
  .wf__title { grid-column: 3 / -1; }

  /* ── static list (default) ──────────────────────────────────────────────────────────── */
  .deck__list { display: grid; gap: var(--space-s); }
  .deck__item { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: center; padding-block-start: var(--space-s); border-block-start: 1px solid var(--line); }
  .deck__panel { grid-column: 3 / span 5; display: grid; gap: 1.5rem; justify-items: start; align-content: center; }
  .deck__card { grid-column: 9 / span 4; position: relative; aspect-ratio: 4 / 5; overflow: clip; border-radius: 10px; background: var(--studio-2); }
  .deck__card img { width: 100%; height: 100%; object-fit: cover; user-select: none; -webkit-user-drag: none; }
  .deck__cap { position: absolute; inset-inline-start: 0.85rem; inset-block-end: 0.85rem; max-width: calc(100% - 1.7rem); }
  .deck__title { font-size: clamp(2.5rem, 5vw, 5.5rem); }
  .deck__body { color: var(--bone-soft); }
  .deck__roles { display: grid; gap: 0.9rem; inline-size: 100%; }
  .deck__roles ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 var(--gutter); }
  .deck__roles li { padding-block: 0.55rem; border-block-start: 1px solid var(--line); font-size: var(--t-small); line-height: 1.4; }

  /* ── live deck ──────────────────────────────────────────────────────────────────────── */
  .deck[data-live] { position: relative; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: center; min-height: var(--deck-h, auto); }
  .deck[data-live] .deck__list { display: contents; }
  .deck[data-live] .deck__item { display: contents; }
  /* All five panels share one grid cell; height is reserved for the tallest so the page never shifts. */
  .deck[data-live] .deck__panel { grid-column: 3 / span 5; grid-row: 1; opacity: 0; visibility: hidden; transform: translateY(12px); transition: opacity 240ms ease, transform 240ms ease, visibility 0s linear 240ms; }
  .deck[data-live] .deck__item[data-current] .deck__panel { opacity: 1; visibility: visible; transform: none; transition: opacity 520ms ease-out 120ms, transform 520ms var(--ease-freeze) 120ms, visibility 0s; }
  .deck[data-live] .deck__card {
    grid-column: 9 / span 4; grid-row: 1; justify-self: center;
    inline-size: min(100%, calc(62vh * 0.8)); touch-action: pan-y; cursor: grab;
    box-shadow: 0 30px 60px -28px rgba(0, 0, 0, 0.85), 0 0 0 1px rgba(243, 237, 227, 0.08);
    will-change: transform; transform: translate3d(var(--x, 0px), var(--y, 0px), 0) rotate(var(--r, 0deg)) scale(var(--s, 1));
    z-index: var(--z, 0);
  }
  .deck[data-live] .deck__card[data-dragging] { cursor: grabbing; }
  .deck[data-live] .deck__card[data-settling] { transition: transform 620ms cubic-bezier(0.2, 1.1, 0.3, 1), opacity 300ms ease; }
  .deck[data-live] .deck__card:not([data-top]) .deck__cap { opacity: 0; }
  .deck[data-live] .deck__cap { transition: opacity 300ms ease; }
  .deck[data-live]:focus-visible { outline-offset: 12px; }

  .deck__ctrl { grid-column: 9 / span 4; grid-row: 2; display: flex; align-items: center; justify-content: center; gap: 1rem; margin-block-start: 2.25rem; }
  .deck__btn { display: grid; place-items: center; inline-size: 3rem; block-size: 3rem; border: 1px solid var(--line-strong); border-radius: 50%; transition: background-color var(--d-state) ease, color var(--d-state) ease, border-color var(--d-state) ease; }
  .deck__btn:hover, .deck__btn:focus-visible { background: var(--bone); color: var(--studio); border-color: var(--bone); }
  .deck__btn[data-deck-prev] :global(.arrow) { scale: -1 1; }
  .deck__btn :global(.arrow) { transform: none !important; }
  .deck__count { min-inline-size: 4.5rem; text-align: center; }
  .deck__count [data-deck-count] { color: var(--accent); }
  .deck__hint { margin-inline-start: 0.75rem; }

  /* ── ways to engage ─────────────────────────────────────────────────────────────────── */
  .eng { margin-block-start: var(--space); display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
  .eng__label { grid-column: 1 / span 2; padding-block-start: 1.6rem; }
  .eng__list { grid-column: 3 / -1; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: var(--gutter); }
  .eng__link { display: grid; gap: 0.75rem; align-content: start; block-size: 100%; padding-block: 1.5rem; border-block-start: 1px solid var(--line); transition: border-color var(--d-state) ease; }
  .eng__link:hover, .eng__link:focus-visible { border-block-start-color: var(--bronze); }

  @media (max-width: 1023px) {
    .wf__label, .wf__title { grid-column: 1 / -1; }
    .deck__item { grid-template-columns: 1fr; row-gap: 2rem; }
    .deck__panel, .deck__card { grid-column: 1 / -1; }
    .deck__card { order: -1; max-inline-size: 30rem; }
    .deck[data-live] { grid-template-columns: 1fr; row-gap: 0; }
    .deck[data-live] .deck__card { grid-column: 1; grid-row: 1; inline-size: min(78vw, calc(56svh * 0.8)); }
    .deck__ctrl { grid-column: 1; grid-row: 2; margin-block: 1.75rem 2.5rem; }
    .deck[data-live] .deck__panel { grid-column: 1; grid-row: 3; }
    .eng { display: block; }
    .eng__label { margin-block-end: 1rem; }
    .eng__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 699px) {
    .deck__roles ul { grid-template-columns: 1fr; }
    .deck__hint { display: none; }
    .eng__list { grid-template-columns: 1fr; }
  }
</style>
