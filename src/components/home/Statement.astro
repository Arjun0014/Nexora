---
/** Directly under the title card: what Nexora is, and the four confirmed facts. The stillness beat. */
import { statement } from '../../data/content';
---
<section class="st surface section" id="statement" data-theme="dark" aria-labelledby="st-h" tabindex="-1">
  <div class="wrap grid" data-reveal>
    <p class="label label--soft st__label" data-rise>{statement.label}</p>
    <div class="st__body">
      <h2 id="st-h" class="sr-only">Who we are</h2>
      <p class="h2 st__lead" data-rise style="--i:1">{statement.body}</p>
    </div>
    <dl class="st__facts">
      {statement.facts.map((f, i) => (
        <div class="st__fact" data-rise style={`--i:${i + 2}`}>
          <dt class="label label--soft">{f.k}</dt>
          <dd>{f.v}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .st { padding-block-start: clamp(3rem, 7vw, 7rem); }
  .st:focus { outline: none; }
  .st__label { grid-column: 1 / span 2; padding-block-start: 0.6rem; }
  .st__body { grid-column: 3 / span 8; }
  .st__lead { max-width: 24em; line-height: 1.16; letter-spacing: -0.015em; }
  .st__facts { grid-column: 3 / -1; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gutter); margin-block-start: var(--space-s); padding-block-start: 1.5rem; border-block-start: 1px solid var(--line); }
  .st__fact { display: grid; gap: 0.6rem; align-content: start; }
  .st__fact dd { font-size: var(--t-small); line-height: 1.5; }

  @media (max-width: 1023px) {
    .st__label { grid-column: 1 / -1; margin-block-end: 1.5rem; }
    .st__body, .st__facts { grid-column: 1 / -1; }
  }
  @media (max-width: 699px) {
    .st__facts { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 1.75rem; }
  }
</style>
