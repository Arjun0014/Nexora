---
/** "Why Nexora" without superlatives or numbers: five behaviours, and a plain list of what we don't do. */
import { commitments } from '../../data/content';
---
<section class="cm surface section cv-auto" id="expect" data-theme="paper" aria-labelledby="cm-h">
  <div class="wrap">
    <header class="cm__head grid" data-reveal>
      <p class="label label--soft cm__label" data-rise>{commitments.label}</p>
      <h2 id="cm-h" class="h1 cm__title lines">
        {commitments.heading.map((line, i) => <span class="l" style={`--i:${i}`}><span>{i === 0 ? <span class="soft">{line}</span> : line}</span></span>)}
      </h2>
    </header>

    <div class="grid cm__grid">
      <ol class="cm__list">
        {commitments.items.map((c, i) => (
          <li class="cm__item" data-reveal>
            <span class="label num" data-rise>{String(i + 1).padStart(2, '0')}</span>
            <div data-rise style="--i:1">
              <h3 class="h2 cm__name">{c.title}</h3>
              <p class="lead soft cm__body">{c.body}</p>
            </div>
          </li>
        ))}
      </ol>

      <aside class="cm__dont" aria-labelledby="cm-dont-h" data-reveal>
        <h3 id="cm-dont-h" class="label" data-rise>{commitments.dontLabel}</h3>
        <ul>
          {commitments.donts.map((d, i) => <li data-rise style={`--i:${i + 1}`}>{d}</li>)}
        </ul>
      </aside>
    </div>
  </div>
</section>

<style>
  .cm__head { row-gap: 1.5rem; margin-block-end: var(--space-s); }
  .cm__label { grid-column: 1 / span 2; padding-block-start: 0.9rem; }
  .cm__title { grid-column: 3 / -1; }

  .cm__grid { align-items: start; row-gap: var(--space-s); }
  .cm__list { grid-column: 3 / span 6; }
  .cm__item { display: grid; grid-template-columns: 3.5rem 1fr; align-items: baseline; padding-block: clamp(1.5rem, 2.6vw, 2.5rem); border-block-start: 1px solid var(--line); }
  .cm__item:last-child { border-block-end: 1px solid var(--line); }
  .cm__body { margin-block-start: 0.6rem; max-inline-size: 30rem; }

  /* Deliberately unglamorous: a bordered block, small type. */
  .cm__dont { grid-column: 10 / -1; position: sticky; inset-block-start: calc(var(--header-h) + 2rem); padding: 1.5rem; border: 1px solid var(--line-strong); background: var(--paper-2); }
  .cm__dont ul { display: grid; margin-block-start: 1rem; }
  .cm__dont li { padding-block: 0.8rem; border-block-start: 1px solid var(--line); font-size: var(--t-small); line-height: 1.5; }

  @media (max-width: 1023px) {
    .cm__label, .cm__title, .cm__list, .cm__dont { grid-column: 1 / -1; }
    .cm__dont { position: static; }
  }
  @media (max-width: 699px) { .cm__item { grid-template-columns: 2.5rem 1fr; } }
</style>
