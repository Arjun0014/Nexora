---
/**
 * Scenes 3 + 4 — the Workforces gate and the five workforces, in ONE pinned stage so the photograph you fly into
 * can become the top card of the deck (United Carriers' continuity: the object causes the next scene).
 *
 *   gate    WORKFORCES is knocked out of the sky; a photograph of people at work shows through it. Scrolling flies
 *           into the O until the photograph is the whole stage, arriving at its natural scale (never over-zoomed).
 *   morph   the photograph's box shrinks from the stage to the front card's box, leaving its own light behind.
 *   deck    the throwable stack (src/scripts/deck.ts), centred over the world's name set as a monument across
 *           the whole width (ERA's image-over-type). The ground is the active photograph itself, blurred deep and
 *           darkened, so the colour always belongs to the picture and changes with every throw. Description and
 *           roles sit small in the lower corners.
 * Driven by src/scripts/scenes/workforces.ts.
 */
import { worlds } from '../../data/worlds';
import { stock } from '../../data/stock';
import Arrow from '../ui/Arrow.astro';
const first = stock.workforces[worlds[0].id];
---
<section class="wfx" id="workforces" data-wfx data-deck data-bg="dark" data-sector={worlds[0].id} data-cursor-zone="deck" aria-labelledby="wfx-h">
  <div class="wfx__stage" data-wfx-stage>
    <!-- DECK (under everything until the morph lands) -->
    <div class="wfx__deck" data-wfx-deck>
      <div class="wfx__amb" aria-hidden="true">
        {worlds.map((w, i) => (
          <img class="wfx__ambimg" data-deck-panel={w.id} data-on={i === 0 ? 'true' : 'false'} src={stock.workforces[w.id].card.replace('-960', '-640')} alt="" width="640" height="800" loading="lazy" decoding="async" />
        ))}
      </div>

      <h2 id="wfx-h" class="sr-only">The five workforces Nexora supplies</h2>

      <header class="wfx__top">
        <p class="label">Five workforces</p>
        <p class="label wfx__count"><span data-deck-count>01</span> / 0{worlds.length}</p>
      </header>

      <div class="wfx__deckcol">
        <ol class="wfx__stack" data-deck-stack data-cursor="Drag" tabindex="0" role="group" aria-label="Workforces. Drag or throw the top card, or use the arrow keys.">
          {worlds.map((w, i) => {
            const img = stock.workforces[w.id];
            return (
              <li class="wfx__card" data-deck-card={w.id} data-deck-title={w.title} data-sector={w.id}>
                <img src={img.card} srcset={img.cardSrcset} sizes="(max-width: 767px) 70vw, 30vw" alt={img.alt} width="960" height="1200" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" draggable="false" />
                <span class="wfx__cardfoot"><span class="label">{w.n}</span><span class="label">{w.short}</span></span>
              </li>
            );
          })}
        </ol>
        <div class="wfx__controls">
          <button class="wfx__btn" type="button" data-deck-prev aria-label="Previous workforce"><Arrow class="wfx__back" /></button>
          <p class="label wfx__hint">Drag or throw</p>
          <button class="wfx__btn" type="button" data-deck-next aria-label="Next workforce"><Arrow /></button>
        </div>
        <p class="sr-only" aria-live="polite" data-deck-live></p>
      </div>

      <!-- The world's name, in front of the card and across its lower third (the Sectors index's device): bone on the
           ground, and a second copy, clipped to the card, carries a shadow so every letter reads over any photo. -->
      <div class="wfx__monos" data-wfx-monos aria-hidden="true">
        {worlds.map((w, i) => (
          <p class="wfx__mono display" data-deck-panel={w.id} data-mono={w.id} data-on={i === 0 ? 'true' : 'false'}>{w.short}</p>
        ))}
      </div>
      <div class="wfx__monos wfx__monos--over" data-wfx-monos-over aria-hidden="true">
        {worlds.map((w, i) => (
          <p class="wfx__mono display" data-deck-panel={w.id} data-mono={w.id} data-on={i === 0 ? 'true' : 'false'}>{w.short}</p>
        ))}
      </div>

      <div class="wfx__panels">
        {worlds.map((w, i) => (
          <article class="wfx__panel" data-deck-panel={w.id} data-sector={w.id} data-on={i === 0 ? 'true' : 'false'}>
            <div class="wfx__about">
              <h3 class="label wfx__title"><i class="wfx__dot" aria-hidden="true"></i>{w.n} — {w.title}</h3>
              <p class="wfx__line">{w.line}</p>
              <a class="tlink label" href={`/request/?workforce=${w.id}`} data-cursor="Request">Request this workforce<Arrow /></a>
            </div>
            <div class="wfx__rolesbox">
              <p class="label wfx__rk">Typical roles</p>
              <ul class="wfx__roles">{w.roles.map((r) => <li>{r}</li>)}</ul>
            </div>
          </article>
        ))}
      </div>
    </div>

    <!-- GATE: the photograph (morphs into card 1), then the knocked-out sky on top -->
    <div class="wfx__photo" data-wfx-photo aria-hidden="true">
      <img src={first.src} srcset={first.srcset} sizes="100vw" alt="" width="2400" height="1600" loading="lazy" decoding="async" style={`object-position:${first.focus}`} />
    </div>
    <!-- Once we are through the O: the line over the photograph (a pair with Sectors' "Where our people work."),
         and the five workforces along its foot, the first lit because it is the one in the picture. -->
    <div class="wfx__over" data-wfx-over aria-hidden="true">
      <p class="wfx__overh display" data-wfx-overh><span><span>Who we</span></span><span><span><em>supply.</em></span></span></p>
      <ol class="wfx__overlist" data-wfx-overlist>
        {worlds.map((w, i) => (
          <li class="label" style={`--i:${i}`} data-on={i === 0 ? '' : undefined}><span class="wfx__overn">{w.n}</span>{w.short}</li>
        ))}
      </ol>
    </div>
    <canvas class="wfx__mask" data-wfx-mask aria-hidden="true"></canvas>
    <div class="wfx__gateui" data-wfx-gateui aria-hidden="true">
      <p class="label">Chapter two</p>
      <p class="label">Five workforces, one partner</p>
    </div>
  </div>
</section>

<style>
  /* --cardH: the stack's height. The names and the gate share it, so they always find the card. */
  .wfx { --cardH: min(60vh, 40rem); position: relative; color: var(--bone); }
  :global(html.motion) .wfx { height: 470vh; height: 470svh; }
  .wfx__stage { position: relative; min-height: 100svh; overflow: clip; background: #16110f; }
  :global(html.motion) .wfx__stage { position: sticky; top: 0; height: 100vh; height: 100svh; }

  /* ── deck ── */
  .wfx__deck { position: absolute; inset: 0; z-index: 1; /* its own stacking context: the cards stay under the morphing photo */ }

  /* The ground IS the photograph: blurred deep, darkened, a touch more saturated. Cross-fades with each throw. */
  .wfx__amb { position: absolute; inset: 0; overflow: hidden; }
  .wfx__amb::after { content: ''; position: absolute; inset: 0; background:
    radial-gradient(80% 70% at 50% 45%, transparent 0%, rgba(10, 7, 6, 0.55) 100%), linear-gradient(180deg, rgba(10, 7, 6, 0.25), rgba(10, 7, 6, 0.55)); }
  .wfx__ambimg { position: absolute; inset: -12%; width: 124%; height: 124%; max-width: none; object-fit: cover;
    filter: blur(48px) brightness(0.62) saturate(1.25); transform: scale(1.1); opacity: 0; transition: opacity 1100ms var(--ease-out); }
  .wfx__ambimg[data-on='true'] { opacity: 1; }

  /* The world's name, in FRONT of the stack, across the card's lower third (as the Sectors index sets its names
     over the picture). The stack is centred with its controls (1.4rem + 3rem) under it, so its top sits at
     50% − cardH/2 − 2.2rem; the name's middle is three quarters of the way down the card. */
  .wfx__monos { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
  .wfx__mono { position: absolute; left: 50%; top: calc(50% + var(--cardH) * 0.25 - 2.2rem); translate: -50% -50%; margin: 0;
    font-size: clamp(3.4rem, 11.5vw, 13rem); line-height: 0.82; color: var(--bone); opacity: 0; white-space: nowrap; perspective: 1200px; }
  .wfx__mono[data-on='true'] { opacity: 1; }
  .wfx__mono :global(.char) { display: inline-block; transform-origin: 50% 85%; }
  /* the copy over the photograph: clipped to the card by workforces.ts, shadowed so it reads on any picture */
  .wfx__monos--over { z-index: 3; }
  .wfx__monos--over .wfx__mono { text-shadow: 0 2px 36px rgba(10, 6, 4, 0.6), 0 1px 3px rgba(10, 6, 4, 0.4); }

  .wfx__top { position: absolute; top: calc(var(--header-h) + 1.5vh); inset-inline: var(--margin); display: flex; justify-content: space-between; }
  .wfx__count { font-variant-numeric: tabular-nums; }

  .wfx__deckcol { position: absolute; left: 50%; top: 50%; translate: -50% -50%; display: grid; justify-items: center; gap: 1.4rem; }
  .wfx__stack { position: relative; width: calc(var(--cardH) * 0.8); height: var(--cardH); touch-action: pan-y; }
  .wfx__stack:focus-visible { outline-offset: 12px; }
  .wfx__card {
    position: absolute; inset: 0; border-radius: 6px; overflow: hidden; background: #2a211c;
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(244, 239, 230, 0.08);
    transform-origin: 50% 140%; -webkit-user-select: none; user-select: none;
  }
  .wfx__card img { width: 100%; height: 100%; object-fit: cover; pointer-events: none; }
  .wfx__cardfoot { position: absolute; inset-inline: 0; bottom: 0; display: flex; justify-content: space-between; padding: 3.2rem 1.2rem 1.1rem; color: var(--bone); background: linear-gradient(0deg, rgba(14, 10, 8, 0.6), transparent); }
  [data-deck][data-live] .wfx__card[data-depth='0'] { cursor: grab; }
  [data-deck][data-live][data-dragging] .wfx__card[data-depth='0'] { cursor: grabbing; }

  .wfx__controls { display: flex; align-items: center; gap: 1.2rem; }
  .wfx__btn { width: 3rem; height: 3rem; border-radius: 50%; border: 1px solid rgba(244, 239, 230, 0.4); display: grid; place-items: center; transition: background-color var(--d-state) ease, color var(--d-state) ease; }
  .wfx__btn:hover, .wfx__btn:focus-visible { background: var(--bone); color: var(--ink); }
  .wfx__back { rotate: 180deg; }
  .wfx__hint { opacity: 0.7; min-width: 8em; text-align: center; }

  .wfx__panels { position: absolute; inset: auto var(--margin) 5vh; pointer-events: none; }
  .wfx__panel { position: absolute; inset-inline: 0; bottom: 0; display: flex; justify-content: space-between; align-items: flex-end; gap: 2rem; opacity: 0; visibility: hidden; transition: opacity 360ms linear, visibility 0s 360ms; }
  .wfx__panel[data-on='true'] { opacity: 1; visibility: visible; transition: opacity 600ms linear 200ms, visibility 0s; }
  .wfx__panel[data-on='true'] a { pointer-events: auto; }
  .wfx__about, .wfx__rolesbox { width: min(22rem, calc((100vw - min(60vh, 40rem) * 0.8) / 2 - var(--margin) - 3rem)); display: grid; gap: 0.9rem; }
  .wfx__title { display: flex; align-items: center; gap: 0.7em; color: var(--bone); }
  .wfx__dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 12px var(--accent); flex: none; }
  .wfx__line { font-size: var(--t-small); line-height: 1.55; color: var(--bone-soft); }
  .wfx__rk { opacity: 0.7; }
  .wfx__roles { display: grid; gap: 0.2rem; font-size: 0.8125rem; color: var(--bone-soft); }
  .wfx__rolesbox { text-align: right; justify-items: end; }

  /* ── gate ── */
  .wfx__photo { position: absolute; z-index: 2; left: 0; top: 0; width: 100%; height: 100%; overflow: hidden; will-change: left, top, width, height; }
  .wfx__photo img { width: 100%; height: 100%; object-fit: cover; will-change: transform; }
  .wfx__mask { position: absolute; inset: 0; z-index: 3; width: 100%; height: 100%; pointer-events: none; }
  .wfx__gateui { position: absolute; inset: auto var(--margin) 6vh; z-index: 4; display: flex; justify-content: space-between; pointer-events: none; transition: opacity 300ms linear; color: var(--ink); }

  /* the line over the photograph, once we are through the O */
  /* lower left, clear of the doorman (he stands just right of centre); centred on an upright phone, where he fills the frame */
  .wfx__over { position: absolute; inset: 0; z-index: 2; pointer-events: none; display: grid; align-content: end; justify-items: start; gap: clamp(1.4rem, 3.4vh, 2.4rem); padding: 0 var(--margin) clamp(2.5rem, 8vh, 5.5rem); color: var(--bone); visibility: hidden; }
  .wfx__over::before { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(14, 10, 8, 0.18), rgba(14, 10, 8, 0) 34%, rgba(14, 10, 8, 0.12) 55%, rgba(14, 10, 8, 0.62)); opacity: var(--scrim, 0); }
  .wfx__overh { position: relative; font-size: clamp(3.4rem, 9vw, 12rem); text-shadow: 0 4px 60px rgba(20, 12, 8, 0.4); }
  .wfx__overh > span { display: block; overflow: clip; overflow-clip-margin: 0.1em; padding-block-end: 0.06em; }
  .wfx__overh > span > span { display: block; }
  .wfx__overlist { position: relative; display: flex; flex-wrap: wrap; gap: 0.6rem clamp(1.2rem, 3.2vw, 3.2rem); max-width: min(46rem, 46vw); }
  .wfx__overlist li { display: inline-flex; gap: 0.7em; opacity: 0; translate: 0 0.8em; transition: opacity 240ms linear, translate 0s 240ms; }
  .wfx__over[data-on] .wfx__overlist li { opacity: 0.5; translate: none; transition: opacity 700ms var(--ease-out), translate 900ms var(--ease-out); transition-delay: calc(var(--i) * 70ms + 260ms); }
  .wfx__over[data-on] .wfx__overlist li[data-on] { opacity: 1; }
  .wfx__overn { opacity: 0.55; }

  /* While the gate runs, the deck's own cards and copy wait underneath. */
  :global(html.motion) .wfx:not([data-landed]) .wfx__card[data-depth='0'] { visibility: hidden; }
  :global(html.motion) .wfx:not([data-landed]) .wfx__card:not([data-depth='0']) { translate: 0 calc((1 - var(--under, 0)) * 70px); filter: opacity(var(--under, 0)); }
  :global(html.motion) .wfx .wfx__panels, :global(html.motion) .wfx .wfx__controls, :global(html.motion) .wfx .wfx__top { opacity: var(--copy, 0); }
  /* the name waits for the card to land (it belongs in FRONT of the card, and the photo is still moving above the
     deck until then); workforces.ts turns its letters in as it lands */
  :global(html.motion) .wfx:not([data-landed]) .wfx__monos { visibility: hidden; }
  :global(html.motion) .wfx[data-landed] .wfx__photo { visibility: hidden; }

  /* No motion: the gate is skipped, the deck is a plain list. */
  :global(html:not(.motion)) .wfx__photo, :global(html:not(.motion)) .wfx__mask, :global(html:not(.motion)) .wfx__gateui, :global(html:not(.motion)) .wfx__monos, :global(html:not(.motion)) .wfx__over { display: none; }
  :global(html:not(.motion)) .wfx__deck { position: relative; display: grid; gap: 3rem; padding: calc(var(--header-h) + 2rem) var(--margin) 4rem; overflow: hidden; }
  :global(html:not(.motion)) .wfx__top, :global(html:not(.motion)) .wfx__deckcol, :global(html:not(.motion)) .wfx__panels, :global(html:not(.motion)) .wfx__panel { position: relative; inset: auto; translate: none; opacity: 1; visibility: visible; }
  :global(html:not(.motion)) .wfx__panels { display: grid; gap: 2.5rem; }
  [data-deck]:not([data-live]) .wfx__stack { width: auto; height: auto; display: grid; grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); gap: var(--gutter); }
  [data-deck]:not([data-live]) .wfx__card { position: relative; aspect-ratio: 4 / 5; }
  [data-deck]:not([data-live]) .wfx__controls { display: none; }
  [data-deck]:not([data-live]) .wfx__deckcol { justify-items: stretch; }

  /* A phone on its side: the card, its name and the two essentials. */
  @media (max-height: 519px) and (orientation: landscape) {
    .wfx { --cardH: 58vh; }
    .wfx__mono { font-size: min(11.5vw, 22vh); }
    .wfx__line, .wfx__rolesbox, .wfx__cardfoot { display: none; }
    .wfx__panels { bottom: 4vh; }
    .wfx__about { width: calc((100vw - var(--cardH) * 0.8) / 2 - var(--margin) - 1.5rem); gap: 0.5rem; }
    .wfx__deckcol { gap: 0.6rem; }
    .wfx__btn { width: 2.4rem; height: 2.4rem; }
    .wfx__overh { font-size: min(9vw, 20vh); }
  }

  @media (max-width: 899px) and (orientation: portrait) {
    .wfx { --cardH: min(46vh, 112vw); }
    .wfx__mono { top: calc(52% + var(--cardH) * 0.25 - 2.2rem); font-size: clamp(2.6rem, 15vw, 6.5rem); }
    .wfx__over { justify-items: center; text-align: center; }
    .wfx__overlist { justify-content: center; max-width: none; }
    .wfx__overh { font-size: clamp(3rem, 15vw, 5.5rem); }
    .wfx__deckcol { top: 52%; }
    .wfx__panels { bottom: 3vh; }
    .wfx__rolesbox { display: none; }
    .wfx__about { width: 100%; }
    .wfx__line { display: none; }
  }
</style>
